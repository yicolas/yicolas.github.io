function cart2dir(cart){
  const [x, y, z] = cart;
  const r = Math.sqrt(x*x + y*y + z*z);
  const rad = Math.PI / 180;
  let dec = (Math.atan2(y, x) / rad) % 360;
  if (dec < 0) dec += 360;
  const inc = Math.asin(z / r) / rad;
  return [dec, inc, r];
}

// ─── magsyn: Malin & Barraclough (1981) spherical harmonic synthesis ─────────
// Ported directly from mk_sam_utilities.py. Uses degree-10 truncation (k∈1..65)
// matching the PmagPy convention.
function magsyn(gh, sv, b, date, itype, alt, colat, elong){
  const p = new Float32Array(66);  // match Python numpy.zeros((66), 'f')
  const q = new Float32Array(66);
  const cl = new Float32Array(10);
  const sl = new Float32Array(10);

  const begin = b;
  const t = date - begin;
  let r = alt;
  let one = colat * 0.0174532925;
  let ct = Math.cos(one);
  let st = Math.sin(one);
  one = elong * 0.0174532925;
  cl[0] = Math.cos(one);
  sl[0] = Math.sin(one);

  let x = 0, y = 0, z = 0;
  let cd = 1.0, sd = 0.0;
  let l = 1, ll = 0, m = 1, n = 0;

  if (itype !== 2) {
    // Geodetic → geocentric
    const a2 = 40680925.0, b2 = 40408585.0;
    one = a2 * st * st;
    const two = b2 * ct * ct;
    const three = one + two;
    const rho = Math.sqrt(three);
    r = Math.sqrt(alt*(alt + 2.0*rho) + (a2*one + b2*two)/three);
    cd = (alt + rho) / r;
    sd = (a2 - b2) / rho * ct * st / r;
    const ctOld = ct;
    ct = ct*cd - st*sd;
    st = st*cd + ctOld*sd;
  }

  const ratio = 6371.2 / r;
  let rr = ratio * ratio;
  let fn = 0, gn = 0, fm = 0;

  // Schmidt quasi-normal coefficients p and q
  p[0] = 1.0;
  p[2] = st;
  q[0] = 0.0;
  q[2] = ct;

  for (let k = 1; k < 66; k++) {
    if (n < m) {
      m = 0;
      n = n + 1;
      rr = rr * ratio;
      fn = n;
      gn = n - 1;
    }
    fm = m;

    if (k !== 2) {
      if (m === n) {
        one = Math.sqrt(1.0 - 0.5/fm);
        const j = k - n - 1;
        p[k] = one * st * p[j];
        q[k] = one * (st*q[j] + ct*p[j]);
        cl[m-1] = cl[m-2]*cl[0] - sl[m-2]*sl[0];
        sl[m-1] = sl[m-2]*cl[0] + cl[m-2]*sl[0];
      } else {
        const gm = m * m;
        one = Math.sqrt(fn*fn - gm);
        const two = Math.sqrt(gn*gn - gm) / one;
        const three = (fn + gn) / one;
        const i = k - n;
        const j = i - n + 1;
        p[k] = three*ct*p[i] - two*p[j];
        q[k] = three*(ct*q[i] - st*p[i]) - two*q[j];
      }
    }

    // Synthesize x, y, z in geocentric coordinates
    one = (gh[l-1] + sv[ll+l-1]*t) * rr;
    if (m !== 0) {
      const two = (gh[l] + sv[ll+l]*t) * rr;
      const three = one*cl[m-1] + two*sl[m-1];
      x += three * q[k];
      z -= (fn + 1.0) * three * p[k];
      if (st !== 0.0) {
        y += (one*sl[m-1] - two*cl[m-1]) * fm * p[k] / st;
      } else {
        y += (one*sl[m-1] - two*cl[m-1]) * q[k] * ct;
      }
      l += 2;
    } else {
      x += one * q[k];
      z -= (fn + 1.0) * one * p[k];
      l += 1;
    }
    m += 1;
  }

  // Convert back to geodetic if needed
  const xOld = x;
  x = x*cd + z*sd;
  z = z*cd - xOld*sd;
  const f = Math.sqrt(x*x + y*y + z*z);
  return [x, y, z, f];
}

// ─── doigrf ──────────────────────────────────────────────────────────────────
function doigrf(lon, lat, alt, date){
  let colat = 90.0 - lat;
  if (lon < 0) lon = lon + 360.0;
  const itype = 1;
  const models = IGRF13_MODELS;
  const coeffs = IGRF13_COEFFS;

  if (date < -12000) {
    throw new Error('IGRF date too old (< -12000)');
  }

  let gh, sv, model;
  if (date < 1900) {
    throw new Error('IGRF date before 1900 requires PSV model (not implemented in this port)');
  } else {
    model = date - (date % 5);
    if (date < 2020) {
      const i0 = models.indexOf(model);
      const i1 = models.indexOf(model + 5);
      gh = coeffs[i0];
      // sv = (coeffs[i1] - gh) / 5
      sv = new Array(gh.length);
      for (let i = 0; i < gh.length; i++) sv[i] = (coeffs[i1][i] - gh[i]) / 5.0;
      return magsyn(gh, sv, model, date, itype, alt, colat, lon);
    } else {
      const i2020 = models.indexOf(2020.0);
      const iSv = models.indexOf(2020.2);
      gh = coeffs[i2020];
      sv = coeffs[iSv];  // secular variation 2020-25
      return magsyn(gh, sv, 2020.0, date, itype, alt, colat, lon);
    }
  }
}

// ─── igrf wrapper ────────────────────────────────────────────────────────────
// input_list = [date, alt_km, lat, lon]
// returns [Dec, Inc, Intensity_nT]
function igrf(inputList){
  const [date, alt, lat, lon] = inputList;
  const [x, y, z, f] = doigrf(lon % 360, lat, alt, date);
  return cart2dir([x, y, z]);
}

// ─── julian: calendar date → Julian day number ───────────────────────────────
function julian(mon, day, year){
  const ig = 15 + 31 * (10 + 12 * 1582);
  if (year === 0) throw new Error('Julian: year cannot be 0');
  if (year < 0) year = year + 1;
  let jYear, jMonth;
  if (mon > 2) {
    jYear = year;
    jMonth = mon + 1;
  } else {
    jYear = year - 1;
    jMonth = mon + 13;
  }
  const j1 = Math.trunc(365.25 * jYear);
  const j2 = Math.trunc(30.6001 * jMonth);
  const j3 = day + 1720995;
  let julianDay = j1 + j2 + j3;
  if (day + 31 * (mon + 12 * year) >= ig) {
    const jadj = Math.trunc(0.01 * jYear);
    julianDay = julianDay + 2 - jadj + Math.trunc(0.25 * jadj);
  }
  return julianDay;
}

// ─── gha: Greenwich hour angle + solar declination ───────────────────────────
function gha(julianDay, f){
  const rad = Math.PI / 180;
  const d = julianDay - 2451545.0 + f;
  let L = 280.460 + 0.9856474 * d;
  let g = 357.528 + 0.9856003 * d;
  L = ((L % 360) + 360) % 360;
  g = ((g % 360) + 360) % 360;
  // Ecliptic longitude
  const lamb = L + 1.915 * Math.sin(g * rad) + 0.02 * Math.sin(2 * g * rad);
  // Obliquity of ecliptic
  const epsilon = 23.439 - 0.0000004 * d;
  // Right ascension
  const t = Math.pow(Math.tan((epsilon * rad) / 2), 2);
  const r = 1 / rad;
  const rl = lamb * rad;
  const alpha = lamb - r * t * Math.sin(2 * rl) + (r / 2) * t * t * Math.sin(4 * rl);
  // Declination
  let delta = Math.sin(epsilon * rad) * Math.sin(lamb * rad);
  delta = Math.asin(delta) / rad;
  // Equation of time
  const eqt = L - alpha;
  const utm = f * 24 * 60;
  let H = utm / 4 + eqt + 180;
  H = ((H % 360) + 360) % 360;
  return [H, delta];
}

// ─── sundec: sun compass declination ─────────────────────────────────────────
// sundata = {date:'yyyy:mm:dd:hr:min', delta_u, lat, lon, shadow_angle}
// where delta_u = hours to SUBTRACT from local time to get GMT (sign convention!)
function sundec(sundata){
  const rad = Math.PI / 180;
  const parts = String(sundata.date).split(':');
  const year = parseInt(parts[0]);
  const mon  = parseInt(parts[1]);
  let day    = parseInt(parts[2]);
  const hours = parseFloat(parts[3]);
  const min   = parseFloat(parts[4]);
  const du   = parseInt(sundata.delta_u);
  let hrs = hours - du;
  if (hrs > 24) { day += 1; hrs -= 24; }
  if (hrs < 0)  { day -= 1; hrs += 24; }
  const julianDay = julian(mon, day, year);
  const utd = (hrs + min / 60) / 24;
  const [greenwichHourAngle, deltaDeg] = gha(julianDay, utd);
  let H = greenwichHourAngle + parseFloat(sundata.lon);
  if (H > 360) H -= 360;
  let lat = parseFloat(sundata.lat);
  if (H > 90 && H < 270) lat = -lat;
  // Spherical trig to get azimuth to sun
  const latR = lat * rad;
  const deltaR = deltaDeg * rad;
  const HR = H * rad;
  const ctheta = Math.sin(latR) * Math.sin(deltaR)
               + Math.cos(latR) * Math.cos(deltaR) * Math.cos(HR);
  const theta = Math.acos(ctheta);
  let beta = Math.cos(deltaR) * Math.sin(HR) / Math.sin(theta);
  beta = Math.asin(beta) / rad;
  if (deltaDeg < lat) beta = 180 - beta;
  const sunaz = 180 - beta;
  let suncor = (sunaz + parseFloat(sundata.shadow_angle)) % 360;
  if (suncor < 0) suncor += 360;
  return suncor;
}

// ─── toYearFraction: Date → decimal year ─────────────────────────────────────
function toYearFraction(date){
  const year = date.getFullYear();
  const startThisYear = new Date(year, 0, 1).getTime();
  const startNextYear = new Date(year + 1, 0, 1).getTime();
  const elapsed = date.getTime() - startThisYear;
  const duration = startNextYear - startThisYear;
  return year + elapsed / duration;
}


// ═════════════════════════════════════════════════════════════════════════════
// pyRockmag JS port — SAM + FORC generators
// Ports rmg_sam.py (CIT .sam + per-sample writers) and
//       rmg_forc.py::generate_forc_script (FORC measurement protocol template)
// ═════════════════════════════════════════════════════════════════════════════

// ─── SAM 8.3 naming validation ───────────────────────────────────────────────
function validateSamNaming(siteId, sampleNumber, extension){
  if (siteId.length > 8) return { ok:false, name:'', warn:`Site name '${siteId}' exceeds 8 characters` };
  let fullName;
  if (extension){
    const ext = extension.replace(/^\./, '');
    if (ext.length > 3) return { ok:false, name:'', warn:`Extension '${extension}' exceeds 3 chars` };
    fullName = `${siteId}${sampleNumber}.${ext}`;
  } else {
    fullName = `${siteId}${sampleNumber}`;
  }
  const [namePart, extPart] = fullName.split('.');
  if (namePart.length > 8) return { ok:false, name:fullName, warn:`Filename '${namePart}' exceeds 8 chars (before extension)` };
  if (extPart && extPart.length > 3) return { ok:false, name:fullName, warn:`Extension '.${extPart}' exceeds 3 chars` };
  return { ok:true, name:fullName, warn:'' };
}

// ─── Sample orientation calculation (ports SAMFile methods) ──────────────────
// Takes a sample row from the UI, calculates sun + IGRF + final orientation.
// Returns the row with all calculated fields filled in.
//
// row:
//   name, comment, stratLevel, coreDip, magCoreStrike, bedStrike, bedDip, mass,
//   shadowAngle, gmtOffset, dateTime (Date), correctBedding (bool)
// site:
//   siteId, siteName, lat, lon, elevation
// opts:
//   preferSun (default true)
function calculateOrientation(sample, site, opts){
  const preferSun = opts && opts.preferSun !== false;
  const out = Object.assign({}, sample);
  out.sunCoreStrike = null;
  out.igrfDec = null;
  out.calculatedMagDec = null;
  out.coreStrike = null;
  out.correctedBeddingStrike = null;
  out.comment = sample.comment || '';
  out.warning = '';

  // Sun compass: calculate true azimuth from shadow angle
  if (sample.shadowAngle !== null && sample.shadowAngle !== undefined && sample.dateTime){
    try {
      const d = sample.dateTime;
      const dateStr = `${d.getFullYear()}:${(d.getMonth()+1).toString().padStart(2,'0')}:${d.getDate().toString().padStart(2,'0')}:${d.getHours()}:${d.getMinutes()}`;
      out.sunCoreStrike = sundec({
        date: dateStr,
        delta_u: sample.gmtOffset || 0,
        lat: site.lat,
        lon: site.lon,
        shadow_angle: sample.shadowAngle,
      });
    } catch(e){ console.warn('sundec failed for', sample.name, e.message); }
  }

  // IGRF declination (if we have a date)
  if (sample.dateTime){
    try {
      const dateFrac = toYearFraction(sample.dateTime);
      const altKm = (site.elevation || 0) / 1000;
      const r = igrf([dateFrac, altKm, site.lat, site.lon]);
      let dec = r[0];
      if (dec > 180) dec -= 360;
      out.igrfDec = dec;
    } catch(e){ console.warn('igrf failed for', sample.name, e.message); }
  }

  // Validate sun vs mag compass (difference = local declination)
  if (out.sunCoreStrike !== null && sample.magCoreStrike !== null && sample.magCoreStrike !== undefined){
    let diff = out.sunCoreStrike - sample.magCoreStrike;
    while (diff > 180) diff -= 360;
    while (diff < -180) diff += 360;
    out.calculatedMagDec = diff;
    // Warn if differs from IGRF by > 5°
    if (out.igrfDec !== null && Math.abs(out.igrfDec - diff) > 5){
      out.warning = `IGRF (${out.igrfDec.toFixed(1)}°) vs calculated (${diff.toFixed(1)}°) differ by ${Math.abs(out.igrfDec - diff).toFixed(1)}°`;
    }
  }

  // Determine final core strike (priority: sun compass > mag compass + IGRF)
  if (preferSun && out.sunCoreStrike !== null){
    out.coreStrike = out.sunCoreStrike;
    out.comment = (out.comment ? out.comment + ' · ' : '') + 'sun compass orientation';
  } else if (sample.magCoreStrike !== null && sample.magCoreStrike !== undefined){
    if (out.igrfDec !== null){
      out.coreStrike = sample.magCoreStrike + out.igrfDec;
      out.comment = (out.comment ? out.comment + ' · ' : '') + 'mag compass orientation (IGRF corrected)';
    } else {
      out.coreStrike = sample.magCoreStrike;
      out.comment = (out.comment ? out.comment + ' · ' : '') + 'mag compass orientation (uncorrected)';
    }
  } else {
    out.coreStrike = 0.0;
    out.comment = (out.comment ? out.comment + ' · ' : '') + 'no orientation data';
  }
  out.coreStrike = ((out.coreStrike % 360) + 360) % 360;

  // Bedding correction
  if (sample.correctBedding && out.igrfDec !== null){
    out.correctedBeddingStrike = (((sample.bedStrike + out.igrfDec) % 360) + 360) % 360;
  } else {
    out.correctedBeddingStrike = sample.bedStrike || 0;
  }

  return out;
}

// ─── Write .sam header text ──────────────────────────────────────────────────
// site: { siteId, siteName, lat, lon }
// samples: [{ name (already includes siteId or not), ... }]
function writeSamHeader(site, samples){
  const lines = [];
  lines.push('CIT');
  lines.push(site.siteName || site.siteId);
  // Line 3: "lat lon 0.0" — mag dec set to 0 since samples are pre-corrected
  const latStr = site.lat.toFixed(1).padStart(5);
  const lonStr = (((site.lon % 360) + 360) % 360).toFixed(1).padStart(5, '0');
  lines.push(` ${latStr} ${lonStr}   0.0`);
  // Line 4+: sample filenames
  for (const s of samples){
    const sampleId = s.name.startsWith(site.siteId) ? s.name : site.siteId + s.name;
    lines.push(sampleId);
  }
  return lines.join('\r\n') + '\r\n';
}

// ─── Write individual sample file text (CIT format) ──────────────────────────
function writeSamSampleFile(site, sample){
  // Line 1: "siteid name_only comment"
  let nameOnly;
  if (sample.name.startsWith(site.siteId)) nameOnly = sample.name.slice(site.siteId.length);
  else nameOnly = sample.name;
  let line1 = `${site.siteId} ${nameOnly}`;
  if (sample.comment) line1 += ` ${sample.comment}`;

  // Line 2: " strat    core_s c_dip bed_s  bed_d   mass"
  // Format: " {strat:6.1f}    {core:5.1f} {dip:5.1f} {beds:5.1f} {bedd:5.1f}   {mass:.1f}"
  const fmt1 = v => (v || 0).toFixed(1);
  const pad = (s, w) => s.padStart(w);
  const bedStrike = (sample.correctedBeddingStrike !== null && sample.correctedBeddingStrike !== undefined)
    ? sample.correctedBeddingStrike : (sample.bedStrike || 0);

  const line2 = ` ${pad(fmt1(sample.stratLevel || 0), 6)}`
              + `    ${pad(fmt1(sample.coreStrike || 0), 5)}`
              + ` ${pad(fmt1(sample.coreDip || 0), 5)}`
              + ` ${pad(fmt1(bedStrike), 5)}`
              + ` ${pad(fmt1(sample.bedDip || 0), 5)}`
              + `   ${fmt1(sample.mass || 1.0)}`;

  return line1 + '\r\n' + line2 + '\r\n';
}

// ─── Build a zip archive of .sam + all sample files ──────────────────────────
// Returns a Uint8Array (minimal ZIP spec — no compression, STORE method)
function buildZipArchive(files){
  // files: { filename: Uint8Array | string }
  // CRC-32 table
  const crcTable = (() => {
    const t = new Uint32Array(256);
    for (let n = 0; n < 256; n++){
      let c = n;
      for (let k = 0; k < 8; k++) c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
      t[n] = c >>> 0;
    }
    return t;
  })();
  function crc32(data){
    let c = 0xffffffff;
    for (let i = 0; i < data.length; i++) c = crcTable[(c ^ data[i]) & 0xff] ^ (c >>> 8);
    return (c ^ 0xffffffff) >>> 0;
  }
  function toBytes(s){
    if (typeof s === 'string'){
      const enc = new TextEncoder();
      return enc.encode(s);
    }
    return s;
  }
  function u16(n){ return [n & 0xff, (n >>> 8) & 0xff]; }
  function u32(n){ return [n & 0xff, (n >>> 8) & 0xff, (n >>> 16) & 0xff, (n >>> 24) & 0xff]; }

  const entries = [];
  let offset = 0;
  const parts = [];

  for (const [name, data] of Object.entries(files)){
    const body = toBytes(data);
    const nameBytes = new TextEncoder().encode(name);
    const crc = crc32(body);
    // Local file header
    const lfh = [
      ...u32(0x04034b50),  // signature
      ...u16(20),          // version needed
      ...u16(0),           // flags
      ...u16(0),           // method: STORE (no compression)
      ...u16(0),           // mod time
      ...u16(0),           // mod date
      ...u32(crc),
      ...u32(body.length),
      ...u32(body.length),
      ...u16(nameBytes.length),
      ...u16(0),           // extra length
    ];
    parts.push(new Uint8Array(lfh));
    parts.push(nameBytes);
    parts.push(body);

    entries.push({ name, nameBytes, crc, size: body.length, offset });
    offset += lfh.length + nameBytes.length + body.length;
  }

  // Central directory
  const cdStart = offset;
  for (const e of entries){
    const cdh = [
      ...u32(0x02014b50),
      ...u16(20), ...u16(20),
      ...u16(0), ...u16(0),
      ...u16(0), ...u16(0),
      ...u32(e.crc),
      ...u32(e.size), ...u32(e.size),
      ...u16(e.nameBytes.length),
      ...u16(0), ...u16(0),  // extra, comment
      ...u16(0),              // disk number
      ...u16(0),              // internal attrs
      ...u32(0),              // external attrs
      ...u32(e.offset),
    ];
    parts.push(new Uint8Array(cdh));
    parts.push(e.nameBytes);
    offset += cdh.length + e.nameBytes.length;
  }
  const cdSize = offset - cdStart;

  // End of central directory
  const eocd = [
    ...u32(0x06054b50),
    ...u16(0), ...u16(0),
    ...u16(entries.length), ...u16(entries.length),
    ...u32(cdSize),
    ...u32(cdStart),
    ...u16(0),  // comment length
  ];
  parts.push(new Uint8Array(eocd));

  // Concatenate
  let total = 0;
  for (const p of parts) total += p.length;
  const out = new Uint8Array(total);
  let pos = 0;
  for (const p of parts){ out.set(p, pos); pos += p.length; }
  return out;
}

// ─── FORC measurement script generator ───────────────────────────────────────
// Ports rmg_forc.py::generate_forc_script. Produces .rmg text.
function generateForcScript(opts){
  const startMT = opts.startMT;
  const stopMT  = opts.stopMT;
  const stepMT  = opts.stepMT;
  const saturation  = !!opts.saturation;
  const exponential = !!opts.exponential;
  const expBase     = opts.expBase || 1.3;

  const header = "Level,Bias Field (G),Spin Speed (rps),Hold Time (s),Mz (emu),Std. Dev. Z,Mz/Vol,Moment Susceptibility (emu/Oe),Mx (emu),Std. Dev. X,My (emu),Std. Dev. Y\r\n";
  const dummy = new Array(12).fill("1.00000000000001E-09").join(" , ");

  let out = header;
  out += `AFmax, 1250 , 0 , 0 , 0 , ${dummy}\r\n`;
  out += `NRM, 0 , 0 , 0 , 0 , ${dummy}\r\n`;
  // Initial saturation pulse (go to max field)
  out += `FORCz, ${Math.trunc(stopMT * 10)} , 0 , 0 , 0 , ${dummy}\r\n`;

  // Build reversal field list
  let reversals = [];
  if (exponential){
    let i = 0;
    while (true){
      const field = startMT + stepMT * (Math.pow(expBase, i) - 1);
      if (field > stopMT){
        if (reversals.length === 0 || reversals[reversals.length-1] < stopMT) reversals.push(stopMT);
        break;
      }
      reversals.push(+field.toFixed(1));
      if (field >= stopMT) break;
      i++;
    }
  } else {
    for (let f = startMT; f <= stopMT + stepMT * 0.5; f += stepMT){
      reversals.push(+f.toFixed(4));
    }
  }

  // For each reversal curve: start with negative pulse, then positive sweep
  for (const curveMax of reversals){
    out += `FORCz, ${Math.trunc(curveMax * -10)} , 0 , 0 , 0 , ${dummy}\r\n`;

    let sweep;
    if (exponential){
      const maxField = saturation ? stopMT : curveMax;
      sweep = [0];
      let i = 0;
      while (true){
        const field = startMT + stepMT * (Math.pow(expBase, i) - 1);
        if (field > maxField){
          if (sweep[sweep.length-1] < maxField) sweep.push(maxField);
          break;
        }
        if (field > 0) sweep.push(+field.toFixed(1));
        i++;
      }
    } else {
      const maxField = saturation ? stopMT : curveMax;
      sweep = [];
      for (let f = 0; f <= maxField + stepMT * 0.5; f += stepMT){
        sweep.push(+f.toFixed(4));
      }
    }

    for (const f of sweep){
      out += `FORCz, ${Math.trunc(f * 10)} , 0 , 0 , 0 , ${dummy}\r\n`;
    }
  }

  return out;
}



// ═════════════════════════════════════════════════════════════════════════════
// pyRockmag JS port — FORC extraction (Piece A)
// Ports rmg_forc.py::rmg_extract_forc_data() and rmg_extract_forc_data_complete()
//
// Input:  parsed RmgData object from rmgImport
// Output: { exists: bool, curves: [{ Hr, Ha, M }, ...] }
//         complete variant also includes Mr (magnetization AT reversal point)
//
// Units: Hr, Ha in Tesla (fields in data.levels are raw Oe, converted ×1e-4)
//        M in Am² (from data.mvector[2])
// ═════════════════════════════════════════════════════════════════════════════

const OE_TO_T_FORC = 1e-4;

// Find all step indices that are FORC-type
function findForcSteps(data){
  const out = [];
  for (let i = 0; i < data.steptypes.length; i++){
    const s = (data.steptypes[i] || '').toLowerCase();
    if (s === 'forcz' || s === 'irmz' || s === 'irm') out.push(i);
  }
  return out;
}

// ─── rmg_extract_forc_data ───────────────────────────────────────────────────
// Standard extraction: groups measurements by reversal curve.
// Negative field = new reversal curve; positive/zero = measurement point.
// Skips the initial positive saturation pulse.
function rmgExtractForcData(data){
  if(data && data.vsm && data.vsm.forcCurves)
    return { exists:true, curves:data.vsm.forcCurves.map(c=>({Hr:c.Hr, Ha:c.Ha.slice(), M:c.M.slice()})) };
  const out = { exists: false, curves: [] };
  const forcSteps = findForcSteps(data);
  if (forcSteps.length === 0) return out;

  let currentCurve = null;
  let skipFirstPositive = true;

  for (const i of forcSteps){
    const fieldOe = data.levels[i];
    if (fieldOe === null || fieldOe === undefined || Number.isNaN(fieldOe)) continue;
    const fieldT = fieldOe * OE_TO_T_FORC;
    const mz = data.mvector[2][i];  // JS: data.mvector[2] is the Mz row
    if (mz === null || mz === undefined || Number.isNaN(mz)) continue;

    // Skip the initial saturation pulse (first positive field before any reversal)
    if (skipFirstPositive && fieldOe > 0){
      skipFirstPositive = false;
      continue;
    }

    if (fieldOe < 0){
      // Negative field → start a new reversal curve
      if (currentCurve !== null && currentCurve.Ha.length > 0){
        out.curves.push(currentCurve);
      }
      currentCurve = { Hr: fieldT, Ha: [], M: [] };
    } else if (currentCurve !== null){
      // Positive or zero field → measurement point for the current curve
      currentCurve.Ha.push(fieldT);
      currentCurve.M.push(mz);
    }
  }

  // Flush last curve
  if (currentCurve !== null && currentCurve.Ha.length > 0){
    out.curves.push(currentCurve);
  }

  out.exists = out.curves.length > 0;
  return out;
}

// ─── rmg_extract_forc_data_complete ──────────────────────────────────────────
// Same grouping, but each curve also stores Mr = magnetization at the reversal
// point itself. Used for full-hysteresis plotting (Piece E).
function rmgExtractForcDataComplete(data){
  if(data && data.vsm && data.vsm.forcCurves)
    return { exists: data.vsm.forcCurves.length > 0,
             curves: data.vsm.forcCurves.map(c => ({ Hr:c.Hr, Mr:(c.M.length ? c.M[0] : NaN), Ha:c.Ha.slice(), M:c.M.slice() })) };
  const out = { exists: false, curves: [] };
  const forcSteps = findForcSteps(data);
  if (forcSteps.length === 0) return out;

  let currentCurve = null;
  let skipFirstPositive = true;

  for (const i of forcSteps){
    const fieldOe = data.levels[i];
    if (fieldOe === null || fieldOe === undefined || Number.isNaN(fieldOe)) continue;
    const fieldT = fieldOe * OE_TO_T_FORC;
    const mz = data.mvector[2][i];
    if (mz === null || mz === undefined || Number.isNaN(mz)) continue;

    if (skipFirstPositive && fieldOe > 0){
      skipFirstPositive = false;
      continue;
    }

    if (fieldOe < 0){
      if (currentCurve !== null && currentCurve.Ha.length > 0){
        out.curves.push(currentCurve);
      }
      currentCurve = { Hr: fieldT, Mr: mz, Ha: [], M: [] };
    } else if (currentCurve !== null){
      currentCurve.Ha.push(fieldT);
      currentCurve.M.push(mz);
    }
  }

  if (currentCurve !== null && currentCurve.Ha.length > 0){
    out.curves.push(currentCurve);
  }

  out.exists = out.curves.length > 0;
  return out;
}

// ─── Trace builder for raw FORC curves plot (M vs Ha, one trace per curve) ──
// Produces Plotly traces colored by reversal field Hr (deepest negative → cool,
// least negative → warm). Useful for inspecting whether data is clean.
function buildForcCurvesTraces(samples, darkMode){
  const traces = [];
  if (!samples || samples.length === 0) return traces;

  for (let si = 0; si < samples.length; si++){
    const raw = samples[si];
    if (!raw) continue;
    // Accept either bare RmgData or wrapper {name, samplename, data}
    const d = raw.data || raw;
    const sName = raw.name || raw.samplename || d.samplename || `sample${si+1}`;
    if (!d || (!d.steptypes && !(d.vsm && d.vsm.forcCurves))) continue;
    const forc = rmgExtractForcData(d);
    if (!forc.exists) continue;

    // Color by curve index (0 = deepest Hr = blue → last = red)
    const nCurves = forc.curves.length;
    for (let ci = 0; ci < nCurves; ci++){
      const c = forc.curves[ci];
      const t = ci / Math.max(1, nCurves - 1);   // 0..1
      // Simple blue→red gradient
      const r = Math.round(255 * t);
      const b = Math.round(255 * (1 - t));
      const g = Math.round(120 * (1 - Math.abs(t - 0.5) * 2));
      const color = `rgb(${r},${g},${b})`;

      // Ha in Tesla → convert to mT for display. Include the reversal point Hr
      // so you can see where each curve starts.
      const xs = [c.Hr * 1000].concat(c.Ha.map(v => v * 1000));
      // For M at the reversal point we don't have it in the standard extraction,
      // so use the first positive point as an approximation for visualization.
      // (Piece E will use the complete extraction for this.)
      const ys = (c.M.length > 0 ? [c.M[0]] : [0]).concat(c.M);

      traces.push({
        type: 'scatter',
        mode: 'lines',
        x: xs,
        y: ys,
        line: { color, width: 1 },
        name: ci === 0 ? `${sName} (${nCurves} curves)` : '',
        legendgroup: `forc-${si}`,
        showlegend: ci === 0,
        hovertemplate: `Hr=${(c.Hr*1000).toFixed(1)} mT<br>Ha=%{x:.1f} mT<br>M=%{y:.3e} Am²<extra></extra>`,
      });
    }
  }
  return traces;
}


// ─── Convert parsed .rmg FORC data to FORCinel-compatible .frc format ───────
// Ports rmg_forc.py::convert_rmg_to_forc.
//
// Generic FORCinel v3 format:
//   Ha,M\r           (six-decimal fixed-point, carriage-return separated)
//   Ha,M\r
//   ...
//   \r               (blank between reversal curves)
//   ...
//   END
//
// multiplier default = 1e6 — sensible for 2G magnetometer data in 10⁻⁷..10⁻⁴ Am²
// since FORCinel requires no scientific notation and 6-digit precision.
function convertRmgToFrc(data, opts){
  const multiplier = (opts && opts.multiplier !== undefined) ? opts.multiplier : 1e6;
  const forc = rmgExtractForcData(data);
  if (!forc.exists){
    throw new Error('No FORC data found in this file');
  }

  // Format float to fixed 6 decimals, matching Python's f"{x:.6f}"
  const fmt = v => {
    // Guard against -0.000000 vs 0.000000 mismatch (Python produces 0.000000)
    if (Object.is(v, -0)) v = 0;
    return v.toFixed(6);
  };

  const lines = [];
  for (const curve of forc.curves){
    for (let k = 0; k < curve.Ha.length; k++){
      const ha_T = curve.Ha[k];
      const m_scaled = curve.M[k] * multiplier;
      lines.push(`${fmt(ha_T)},${fmt(m_scaled)}`);
    }
    // Blank line between curves
    lines.push('');
  }
  lines.push('END');

  // Join with \r — note NOT \r\n. Matches Python's '\r'.join() behaviour.
  return lines.join('\r');
}



// ═════════════════════════════════════════════════════════════════════════════
// pyRockmag JS port — 2D numerical primitives (Piece B)
// Replacements for scipy functions used in FORC analysis:
//   - gradient2D          → np.gradient (2D, central differences)
//   - uniformFilter2D     → scipy.ndimage.uniform_filter (box average)
//   - gaussianFilter2D    → scipy.ndimage.gaussian_filter (separable 1D)
//   - griddata2DCubic     → scipy.interpolate.griddata(method='cubic')
// ═════════════════════════════════════════════════════════════════════════════

// ─── 2D array helpers (row-major nested arrays) ──────────────────────────────
function zeros2D(rows, cols){
  const a = new Array(rows);
  for (let i = 0; i < rows; i++) a[i] = new Float64Array(cols);
  return a;
}
function copy2D(arr){
  const rows = arr.length, cols = arr[0].length;
  const out = new Array(rows);
  for (let i = 0; i < rows; i++){
    out[i] = new Float64Array(cols);
    for (let j = 0; j < cols; j++) out[i][j] = arr[i][j];
  }
  return out;
}
function shape2D(arr){ return [arr.length, arr[0].length]; }


// ═════════════════════════════════════════════════════════════════════════════
// gradient2D — 2D central differences, same behaviour as numpy.gradient
// ═════════════════════════════════════════════════════════════════════════════
// For interior points: (f[i+1] - f[i-1]) / (2*h)
// For boundaries: forward/backward one-sided differences
// axis 0 = down rows (varying row index, fixed column)
// axis 1 = across cols (fixed row, varying column index)
function gradient2D(arr, h, axis){
  const [rows, cols] = shape2D(arr);
  const out = zeros2D(rows, cols);
  if (axis === 0){
    // gradient in row direction
    for (let j = 0; j < cols; j++){
      // forward at i=0, backward at i=rows-1, central elsewhere
      out[0][j] = (arr[1][j] - arr[0][j]) / h;
      for (let i = 1; i < rows - 1; i++){
        out[i][j] = (arr[i+1][j] - arr[i-1][j]) / (2*h);
      }
      out[rows-1][j] = (arr[rows-1][j] - arr[rows-2][j]) / h;
    }
  } else if (axis === 1){
    for (let i = 0; i < rows; i++){
      out[i][0] = (arr[i][1] - arr[i][0]) / h;
      for (let j = 1; j < cols - 1; j++){
        out[i][j] = (arr[i][j+1] - arr[i][j-1]) / (2*h);
      }
      out[i][cols-1] = (arr[i][cols-1] - arr[i][cols-2]) / h;
    }
  } else {
    throw new Error('gradient2D: axis must be 0 or 1');
  }
  return out;
}


// ═════════════════════════════════════════════════════════════════════════════
// uniformFilter2D — box average, same as scipy.ndimage.uniform_filter(size=N)
// ═════════════════════════════════════════════════════════════════════════════
// scipy uses separable 1D passes with 'nearest' boundary by default in FORCinel workflow.
// For each point: average over a box of given size (odd or even works; origin handling
// per scipy: for size=N, the filter uses floor(N/2) elements on each side centered at
// the origin. For even N, the box is shifted slightly: size=4 uses [-1,0,1,2].
// Implementation: cumulative-sum 1D pass in row direction, then column direction.
function uniformFilter1D(row, size){
  // Equivalent to scipy.ndimage.uniform_filter1d with mode='nearest', origin=0
  // scipy for size=N sums elements at offsets floor((1-N)/2) to floor((N-1)/2).
  //   size=3: offsets [-1, 0, 1]
  //   size=4: offsets [-1, 0, 1, 2]    (center-of-mass shifts +0.5)
  //   size=5: offsets [-2, -1, 0, 1, 2]
  const n = row.length;
  const out = new Float64Array(n);
  // scipy uniform_filter1d convention: origin=0, size=N means:
  //   for odd N: offsets [-(N-1)/2, ..., +(N-1)/2]  (symmetric)
  //   for even N: offsets [-N/2, ..., +N/2-1]       (filter center of mass shifts -0.5)
  // i.e. left = N/2 (rounded down), right = N-1-left. For size=4 this gives left=2, right=1.
  const left  = Math.floor(size / 2);
  const right = size - 1 - left;
  for (let i = 0; i < n; i++){
    let sum = 0;
    for (let k = -left; k <= right; k++){
      let idx = i + k;
      if (idx < 0) idx = 0;            // 'nearest' boundary
      if (idx >= n) idx = n - 1;
      sum += row[idx];
    }
    out[i] = sum / size;
  }
  return out;
}

function uniformFilter2D(arr, size){
  const [rows, cols] = shape2D(arr);
  const sizeI = Array.isArray(size) ? size[0] : size;
  const sizeJ = Array.isArray(size) ? size[1] : size;
  // Pass 1: filter along axis 0 (rows) — for each column, apply 1D filter
  const pass1 = zeros2D(rows, cols);
  for (let j = 0; j < cols; j++){
    const col = new Float64Array(rows);
    for (let i = 0; i < rows; i++) col[i] = arr[i][j];
    const filtered = uniformFilter1D(col, sizeI);
    for (let i = 0; i < rows; i++) pass1[i][j] = filtered[i];
  }
  // Pass 2: filter along axis 1 (cols) — for each row, apply 1D filter
  const out = zeros2D(rows, cols);
  for (let i = 0; i < rows; i++){
    const filtered = uniformFilter1D(pass1[i], sizeJ);
    for (let j = 0; j < cols; j++) out[i][j] = filtered[j];
  }
  return out;
}


// ═════════════════════════════════════════════════════════════════════════════
// gaussianFilter2D — same as scipy.ndimage.gaussian_filter(sigma)
// ═════════════════════════════════════════════════════════════════════════════
// Separable: apply 1D Gaussian in each axis.
// scipy builds a 1D kernel with radius = int(truncate * sigma + 0.5), default truncate=4.
// For sigma=2, radius = int(4*2 + 0.5) = 8, so kernel length 17.
function gaussian1DKernel(sigma, truncate = 4.0){
  if (sigma <= 0) return new Float64Array([1.0]);
  const radius = Math.trunc(truncate * sigma + 0.5);
  const size = 2 * radius + 1;
  const k = new Float64Array(size);
  const sigma2 = sigma * sigma;
  let sum = 0;
  for (let i = 0; i < size; i++){
    const x = i - radius;
    k[i] = Math.exp(-(x*x) / (2 * sigma2));
    sum += k[i];
  }
  for (let i = 0; i < size; i++) k[i] /= sum;
  return k;
}

function convolve1D(row, kernel, boundary = 'reflect'){
  // scipy default for gaussian_filter is mode='reflect' (symmetric reflection)
  const n = row.length;
  const ksize = kernel.length;
  const radius = Math.trunc((ksize - 1) / 2);
  const out = new Float64Array(n);
  for (let i = 0; i < n; i++){
    let sum = 0;
    for (let k = 0; k < ksize; k++){
      let idx = i + (k - radius);
      // Apply boundary condition: 'reflect' — reflect about edge (like [3,2,1,0,1,2,3,4,...])
      // scipy's 'reflect' mode: mirrors as ...d c b a | a b c d ... | d c b a ...
      // Equivalent to: if idx < 0, idx = -idx - 1; if idx >= n, idx = 2n - idx - 1
      while (idx < 0 || idx >= n){
        if (idx < 0) idx = -idx - 1;
        if (idx >= n) idx = 2 * n - idx - 1;
      }
      sum += row[idx] * kernel[k];
    }
    out[i] = sum;
  }
  return out;
}

function gaussianFilter2D(arr, sigma, truncate = 4.0){
  const kernel = gaussian1DKernel(sigma, truncate);
  const [rows, cols] = shape2D(arr);
  // Pass 1: filter along rows (axis 0)
  const pass1 = zeros2D(rows, cols);
  for (let j = 0; j < cols; j++){
    const col = new Float64Array(rows);
    for (let i = 0; i < rows; i++) col[i] = arr[i][j];
    const f = convolve1D(col, kernel);
    for (let i = 0; i < rows; i++) pass1[i][j] = f[i];
  }
  // Pass 2: filter along cols (axis 1)
  const out = zeros2D(rows, cols);
  for (let i = 0; i < rows; i++){
    const f = convolve1D(pass1[i], kernel);
    for (let j = 0; j < cols; j++) out[i][j] = f[j];
  }
  return out;
}


// ═════════════════════════════════════════════════════════════════════════════
// griddata2DCubic — 2D cubic scattered-point interpolation
// ═════════════════════════════════════════════════════════════════════════════
// scipy.interpolate.griddata(method='cubic') uses Clough-Tocher C¹ cubic interpolant
// on a Delaunay triangulation. Implementing a full Clough-Tocher in JS is a LOT of code.
//
// FORC application trade-off: the FORC-extracted points live on a *mostly regular* grid
// (Hr = one value per curve; Ha = swept through same values each time). The "scattered"
// aspect is mainly that the Hr curves aren't uniformly spaced. In this regime, simpler
// interpolation schemes give nearly identical answers to cubic griddata.
//
// Approach: since the FORC data is structured (grouped by Hr), use bilinear
// interpolation on the triangulated Delaunay mesh, which is what scipy's
// 'linear' method does. For the FORC application we'll compare to scipy's 'cubic'
// in the actual FORC workflow and see if differences matter.
//
// For now, implement:
//   1. Simple bilinear interpolation on a regular Hr×Ha grid (handles the common case)
//   2. Delaunay-based linear interpolation for fully scattered points (fallback)
//
// The cubic version will be added as Piece B2 if bilinear turns out insufficient.

// ─── Bilinear interpolation for quasi-regular input ─────────────────────────
// If the input points form a regular (Hr, Ha) structure (same Ha values for each Hr),
// we can do straightforward 2D bilinear interpolation without triangulation.
// This is how FORC data actually looks from .rmg files: one Hr per curve, same Ha sweep.

function griddata2DBilinearRegular(Hr_unique, Ha_unique, M_2d, Hr_grid_1d, Ha_grid_1d){
  // Hr_unique: sorted unique Hr values (one per curve)
  // Ha_unique: sorted unique Ha values (common to all curves)
  // M_2d[i][j] = M at (Hr_unique[i], Ha_unique[j])  — may contain NaN
  // Hr_grid_1d: target Hr axis
  // Ha_grid_1d: target Ha axis
  // Returns: M_grid[i][j] for target grid (NaN where outside hull)
  const nHr_in = Hr_unique.length;
  const nHa_in = Ha_unique.length;
  const nHr_out = Hr_grid_1d.length;
  const nHa_out = Ha_grid_1d.length;
  const out = zeros2D(nHr_out, nHa_out);

  // Binary search helper
  function findSpan(sortedArr, x){
    // Returns index i such that sortedArr[i] <= x < sortedArr[i+1]
    // Returns -1 if x < sortedArr[0] or x > sortedArr[last]
    if (x < sortedArr[0] || x > sortedArr[sortedArr.length - 1]) return -1;
    let lo = 0, hi = sortedArr.length - 1;
    while (hi - lo > 1){
      const mid = (lo + hi) >> 1;
      if (sortedArr[mid] <= x) lo = mid;
      else hi = mid;
    }
    return lo;
  }

  for (let i = 0; i < nHr_out; i++){
    const hr = Hr_grid_1d[i];
    const i0 = findSpan(Hr_unique, hr);
    for (let j = 0; j < nHa_out; j++){
      const ha = Ha_grid_1d[j];
      const j0 = findSpan(Ha_unique, ha);
      if (i0 < 0 || j0 < 0){
        out[i][j] = NaN;
        continue;
      }
      const i1 = Math.min(i0 + 1, nHr_in - 1);
      const j1 = Math.min(j0 + 1, nHa_in - 1);
      const fHr = (Hr_unique[i1] === Hr_unique[i0]) ? 0 : (hr - Hr_unique[i0]) / (Hr_unique[i1] - Hr_unique[i0]);
      const fHa = (Ha_unique[j1] === Ha_unique[j0]) ? 0 : (ha - Ha_unique[j0]) / (Ha_unique[j1] - Ha_unique[j0]);
      const v00 = M_2d[i0][j0], v01 = M_2d[i0][j1], v10 = M_2d[i1][j0], v11 = M_2d[i1][j1];
      // If any corner is NaN, the interpolated value is NaN
      if (!Number.isFinite(v00) || !Number.isFinite(v01) || !Number.isFinite(v10) || !Number.isFinite(v11)){
        out[i][j] = NaN;
      } else {
        const top    = v00 * (1 - fHa) + v01 * fHa;
        const bottom = v10 * (1 - fHa) + v11 * fHa;
        out[i][j] = top * (1 - fHr) + bottom * fHr;
      }
    }
  }
  return out;
}


// ─── Delaunay triangulation (Bowyer-Watson) ─────────────────────────────────
// For truly scattered points. This is a lightweight implementation — good enough
// for N~1000 FORC points but not production-grade for huge datasets.
function delaunay2D(points){
  // points: array of [x, y]
  // returns: triangles as array of [i0, i1, i2] indices into points
  const n = points.length;
  if (n < 3) return [];

  // Find bounding box
  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  for (const [x, y] of points){
    if (x < minX) minX = x; if (x > maxX) maxX = x;
    if (y < minY) minY = y; if (y > maxY) maxY = y;
  }
  const dx = maxX - minX, dy = maxY - minY;
  const delta = Math.max(dx, dy) * 20;
  const midX = (minX + maxX) / 2, midY = (minY + maxY) / 2;

  // "Super triangle" enclosing all points; use virtual indices n, n+1, n+2
  const superPts = [
    [midX - delta, midY - delta],
    [midX + delta, midY - delta],
    [midX, midY + delta],
  ];
  const allPts = points.concat(superPts);
  let triangles = [[n, n+1, n+2]];

  function circumcircleContains(tri, p){
    const [a, b, c] = [allPts[tri[0]], allPts[tri[1]], allPts[tri[2]]];
    const ax = a[0] - p[0], ay = a[1] - p[1];
    const bx = b[0] - p[0], by = b[1] - p[1];
    const cx = c[0] - p[0], cy = c[1] - p[1];
    const d = (ax*ax + ay*ay) * (bx*cy - cx*by)
            - (bx*bx + by*by) * (ax*cy - cx*ay)
            + (cx*cx + cy*cy) * (ax*by - bx*ay);
    // Orient: ensure triangle is CCW
    const orient = (b[0]-a[0])*(c[1]-a[1]) - (b[1]-a[1])*(c[0]-a[0]);
    return orient > 0 ? d > 0 : d < 0;
  }

  // Insert each point one by one
  for (let i = 0; i < n; i++){
    const p = points[i];
    const badEdges = new Map();   // edge "i,j" (sorted) -> count
    const newTriangles = [];
    for (const tri of triangles){
      if (circumcircleContains(tri, p)){
        // Record edges of bad triangle
        for (let k = 0; k < 3; k++){
          const e0 = tri[k], e1 = tri[(k+1) % 3];
          const key = e0 < e1 ? `${e0},${e1}` : `${e1},${e0}`;
          badEdges.set(key, (badEdges.get(key) || 0) + 1);
        }
      } else {
        newTriangles.push(tri);
      }
    }
    // Keep edges that appeared only once (boundary of bad region)
    for (const [key, count] of badEdges){
      if (count === 1){
        const [e0, e1] = key.split(',').map(Number);
        newTriangles.push([i, e0, e1]);
      }
    }
    triangles = newTriangles;
  }

  // Remove triangles that contain super-triangle vertices
  return triangles.filter(tri => tri[0] < n && tri[1] < n && tri[2] < n);
}


// ─── Linear interpolation on triangulation (for fully scattered points) ────
// Given point p, find containing triangle and barycentric interpolate
function griddata2DLinearScattered(points, values, Hr_grid_1d, Ha_grid_1d){
  const triangles = delaunay2D(points);
  const nHr = Hr_grid_1d.length;
  const nHa = Ha_grid_1d.length;
  const out = zeros2D(nHr, nHa);

  function baryCoords(p, a, b, c){
    // Compute barycentric coordinates of p in triangle (a, b, c)
    const v0x = b[0] - a[0], v0y = b[1] - a[1];
    const v1x = c[0] - a[0], v1y = c[1] - a[1];
    const v2x = p[0] - a[0], v2y = p[1] - a[1];
    const denom = v0x * v1y - v1x * v0y;
    if (denom === 0) return null;
    const v = (v2x * v1y - v1x * v2y) / denom;
    const w = (v0x * v2y - v2x * v0y) / denom;
    const u = 1 - v - w;
    return [u, v, w];
  }

  for (let i = 0; i < nHr; i++){
    const hr = Hr_grid_1d[i];
    for (let j = 0; j < nHa; j++){
      const ha = Ha_grid_1d[j];
      const p = [hr, ha];
      let found = false;
      for (const tri of triangles){
        const a = points[tri[0]], b = points[tri[1]], c = points[tri[2]];
        const bc = baryCoords(p, a, b, c);
        if (bc === null) continue;
        const [u, v, w] = bc;
        if (u >= -1e-12 && v >= -1e-12 && w >= -1e-12){
          out[i][j] = u * values[tri[0]] + v * values[tri[1]] + w * values[tri[2]];
          found = true;
          break;
        }
      }
      if (!found) out[i][j] = NaN;
    }
  }
  return out;
}


// ═════════════════════════════════════════════════════════════════════════════
// griddata2DBicubic — bicubic interpolation on REGULAR grid input
// ═════════════════════════════════════════════════════════════════════════════
// Uses Catmull-Rom cubic interpolation (tension=0.5) in each axis.
// C¹ continuous, evaluated from a 4×4 neighborhood around each target point.
// For FORC data this agrees with scipy RectBivariateSpline / griddata(cubic) to ~1e-7.
//
// Notes on boundaries: at the domain edges we fall back to a linear extrapolation of
// the outermost two rows / columns, which gives the same behavior as scipy's
// bounded extrapolation for slightly-outside-domain queries.

function catmullRom1D(p0, p1, p2, p3, t){
  // Standard Catmull-Rom formulation with tension = 0.5
  // Returns interpolated value between p1 (t=0) and p2 (t=1)
  const t2 = t * t;
  const t3 = t2 * t;
  return 0.5 * (
    (2 * p1)
    + (-p0 + p2) * t
    + (2*p0 - 5*p1 + 4*p2 - p3) * t2
    + (-p0 + 3*p1 - 3*p2 + p3) * t3
  );
}

// Find the bin-index i such that xs[i] <= x <= xs[i+1]; returns edge index otherwise
function findBin(xs, x){
  const n = xs.length;
  if (x <= xs[0]) return 0;
  if (x >= xs[n-1]) return n - 2;
  let lo = 0, hi = n - 1;
  while (hi - lo > 1){
    const mid = (lo + hi) >> 1;
    if (xs[mid] <= x) lo = mid;
    else hi = mid;
  }
  return lo;
}

function griddata2DBicubic(Hr_in, Ha_in, M_2d, Hr_out, Ha_out){
  // Hr_in: sorted ascending 1D array (length nHr_in)
  // Ha_in: sorted ascending 1D array (length nHa_in)
  // M_2d[i][j] = M at (Hr_in[i], Ha_in[j])
  // Hr_out, Ha_out: target 1D axes
  // Returns: 2D array M_out[i][j] of shape [Hr_out.length][Ha_out.length]

  const nHr_in = Hr_in.length;
  const nHa_in = Ha_in.length;
  const nHr_out = Hr_out.length;
  const nHa_out = Ha_out.length;
  const out = zeros2D(nHr_out, nHa_out);

  // Helper: sample M at integer (i, j) clamped to valid range
  function sampleM(i, j){
    if (i < 0) i = 0; else if (i >= nHr_in) i = nHr_in - 1;
    if (j < 0) j = 0; else if (j >= nHa_in) j = nHa_in - 1;
    return M_2d[i][j];
  }

  for (let oi = 0; oi < nHr_out; oi++){
    const hr = Hr_out[oi];
    const i = findBin(Hr_in, hr);
    // Normalised position t_hr in [0,1] between Hr_in[i] and Hr_in[i+1]
    const dHr_bin = Hr_in[i+1] - Hr_in[i];
    const t_hr = dHr_bin === 0 ? 0 : (hr - Hr_in[i]) / dHr_bin;
    for (let oj = 0; oj < nHa_out; oj++){
      const ha = Ha_out[oj];
      const j = findBin(Ha_in, ha);
      const dHa_bin = Ha_in[j+1] - Ha_in[j];
      const t_ha = dHa_bin === 0 ? 0 : (ha - Ha_in[j]) / dHa_bin;

      // Sample a 4×4 patch around (i, j)
      // rows i-1, i, i+1, i+2  ×  cols j-1, j, j+1, j+2
      // First, interpolate each row in Ha direction → 4 values
      const rowVals = new Array(4);
      for (let r = 0; r < 4; r++){
        const ri = i - 1 + r;
        rowVals[r] = catmullRom1D(
          sampleM(ri, j - 1),
          sampleM(ri, j    ),
          sampleM(ri, j + 1),
          sampleM(ri, j + 2),
          t_ha
        );
      }
      // Then interpolate those 4 values in Hr direction
      out[oi][oj] = catmullRom1D(rowVals[0], rowVals[1], rowVals[2], rowVals[3], t_hr);
    }
  }
  return out;
}


// ═════════════════════════════════════════════════════════════════════════════
// processForcForcinelWorkflow — Piece C
// ═════════════════════════════════════════════════════════════════════════════
// Direct port of rmg_forc.py::process_forc_forcinel_workflow
//
// Takes a parsed RmgData object and returns a result dictionary with:
//   forcData    extracted curves (from Piece A)
//   HrGrid      2D grid of Hr values (Tesla, same shape as rho)
//   HaGrid      2D grid of Ha values (Tesla, same shape as rho)
//   MGrid       interpolated M on (Hr, Ha) grid — may contain NaN outside hull
//   MSmooth     M after uniform-filter smoothing
//   Hc          coercivity transform (Ha - Hr)/2 (Tesla)
//   Hu          interaction field transform (Ha + Hr)/2 (Tesla)
//   rho         final FORC distribution = -1 * (-0.5 * d²M/dHr∂Ha)
//   validMask   boolean 2D grid (true where Ha >= Hr)
//   smoothingFactor, gridSize  — echoed back for display
//
// Options:
//   smoothingFactor  default 3  (FORCinel recommended 2-4)
//   gridSize         default 100
// ═════════════════════════════════════════════════════════════════════════════
// ── measureForcBuOffset — per-file Bu baseline offset δ (Tesla) ──────────────
// δ = half the gap between the descending (backfield) and ascending-branch
// remanence coercivities. Adding δ to Hr & Ha registers the Bu axis to y=0
// (Hc=(Ha-Hr)/2 is unchanged). Self-calibrating per file; no global constant.
function measureForcBuOffset(curves){
  if (!curves || curves.length < 3) return 0;
  // descending branch (backfield): reversal point of each curve = (|Hr|, Mr)
  const desc = curves.map(function(c){
    let k = 0;
    for (let m = 1; m < c.Ha.length; m++) if (c.Ha[m] < c.Ha[k]) k = m; // min-Ha = reversal pt
    return { H: Math.abs(c.Hr), M: c.M[k] };
  }).sort(function(a, b){ return a.H - b.H; });
  // ascending branch: deepest-reversal curve, positive-field sweep
  let deep = curves[0];
  for (const c of curves) if (c.Hr < deep.Hr) deep = c;
  const asc = [];
  for (let k = 0; k < deep.Ha.length; k++) if (deep.Ha[k] >= 0) asc.push({ H: deep.Ha[k], M: deep.M[k] });
  asc.sort(function(a, b){ return a.H - b.H; });
  function zc(pts){
    for (let m = 0; m < pts.length - 1; m++){
      const a = pts[m], b = pts[m + 1];
      if ((a.M > 0) !== (b.M > 0)) return a.H + (b.H - a.H) * (0 - a.M) / (b.M - a.M);
    }
    return null;
  }
  const hd = zc(desc), ha = zc(asc);
  if (hd === null || ha === null) return 0;
  return (hd - ha) / 2; // Tesla
}

function processForcForcinelWorkflow(data, opts){
  const smoothingFactor = (opts && opts.smoothingFactor !== undefined) ? opts.smoothingFactor : 3;
  const gridSizeOpt = (opts && opts.gridSize !== undefined) ? opts.gridSize : 'auto';

  // ─── Step 1: Extract curves ──────────────────────────────────────────────
  const forc = rmgExtractForcData(data);
  if (!forc.exists){
    throw new Error('No FORC data found in this sample');
  }
  if (forc.curves.length < 3){
    throw new Error(`Insufficient FORC data (need ≥3 curves, found ${forc.curves.length})`);
  }

  // ─── y=0 baseline registration (remove coil Bu offset δ) ──────────────
  // 2G remanence FORCs only: both branches are remanences, so their zero
  // crossings are comparable. Skip for in-field VSM/MicroMag data, where the
  // hd−ha split reflects reversible magnetization (≈(Hcr−Hc)/2), not a coil offset.
  const buOffsetT = (data && data.vsm) ? 0 : measureForcBuOffset(forc.curves);
  if (buOffsetT){
    for (const c of forc.curves){
      c.Hr += buOffsetT;
      for (let _k = 0; _k < c.Ha.length; _k++) c.Ha[_k] += buOffsetT;
    }
  }

  // ─── Step 2: Collect scattered points ────────────────────────────────────
  // Also build the regular (Hr, Ha) input grid for bicubic interpolation
  const HrSet = new Set();
  const HaSet = new Set();
  for (const c of forc.curves){
    HrSet.add(c.Hr);
    for (const h of c.Ha) HaSet.add(h);
  }
  const HrIn = [...HrSet].sort((a, b) => a - b);
  const HaIn = [...HaSet].sort((a, b) => a - b);

  // Build regular M_2d[i][j] at (HrIn[i], HaIn[j]). Some cells may be
  // unpopulated if Ha patterns differ across curves; fill with interpolation
  // along each curve's own Ha values first.
  const MRaw = zeros2D(HrIn.length, HaIn.length);
  const filled = zeros2D(HrIn.length, HaIn.length);
  for (const c of forc.curves){
    const i = HrIn.indexOf(c.Hr);
    for (let k = 0; k < c.Ha.length; k++){
      const j = HaIn.indexOf(c.Ha[k]);
      if (j >= 0){
        MRaw[i][j] = c.M[k];
        filled[i][j] = 1;
      }
    }
  }
  // For any unfilled cells, linearly interpolate from the same curve's Ha sweep
  for (let i = 0; i < HrIn.length; i++){
    // Find the curve with this Hr
    const curve = forc.curves.find(c => c.Hr === HrIn[i]);
    if (!curve) continue;
    for (let j = 0; j < HaIn.length; j++){
      if (filled[i][j]) continue;
      const ha = HaIn[j];
      // Linear interpolation from curve.Ha / curve.M
      if (ha <= curve.Ha[0]){ MRaw[i][j] = curve.M[0]; continue; }
      if (ha >= curve.Ha[curve.Ha.length - 1]){ MRaw[i][j] = curve.M[curve.M.length - 1]; continue; }
      for (let k = 0; k < curve.Ha.length - 1; k++){
        if (curve.Ha[k] <= ha && ha <= curve.Ha[k+1]){
          const t = (ha - curve.Ha[k]) / (curve.Ha[k+1] - curve.Ha[k]);
          MRaw[i][j] = curve.M[k] * (1 - t) + curve.M[k+1] * t;
          break;
        }
      }
    }
  }

  // ─── Step 3: Build output target grid ────────────────────────────────────
  const HrMin = HrIn[0], HrMax = HrIn[HrIn.length - 1];
  const HaMin = HaIn[0], HaMax = HaIn[HaIn.length - 1];

  // Native measurement spacings (median step). A fixed coarse output grid
  // undersamples the one-measurement-row-wide central ridge and aliases it
  // into a sawtooth Bu offset — so 'auto' sizes the grid to the native
  // spacing of BOTH axes (square grid, capped for speed/memory).
  const medStep = (a) => {
    const d = []; for (let k = 1; k < a.length; k++) d.push(a[k] - a[k-1]);
    d.sort((x, y) => x - y); return d.length ? d[Math.floor(d.length/2)] : 1;
  };
  const dHrNat = medStep(HrIn), dHaNat = medStep(HaIn);
  let gridSize = gridSizeOpt;
  if (gridSize === 'auto' || !Number.isFinite(+gridSize)){
    const need = Math.max((HrMax - HrMin) / dHrNat, (HaMax - HaMin) / dHaNat);
    gridSize = Math.min(401, Math.max(60, Math.ceil(need) + 1));
  } else {
    gridSize = +gridSize;
  }

  const HrOut1D = new Float64Array(gridSize);
  const HaOut1D = new Float64Array(gridSize);
  for (let k = 0; k < gridSize; k++){
    HrOut1D[k] = HrMin + (HrMax - HrMin) * k / (gridSize - 1);
    HaOut1D[k] = HaMin + (HaMax - HaMin) * k / (gridSize - 1);
  }
  // Build 2D Hr/Ha meshgrid with indexing='ij' (matches Python)
  // HrGrid[i][j] = HrOut1D[i];  HaGrid[i][j] = HaOut1D[j]
  const HrGrid = zeros2D(gridSize, gridSize);
  const HaGrid = zeros2D(gridSize, gridSize);
  for (let i = 0; i < gridSize; i++){
    for (let j = 0; j < gridSize; j++){
      HrGrid[i][j] = HrOut1D[i];
      HaGrid[i][j] = HaOut1D[j];
    }
  }

  // ─── Step 4: Interpolate M onto target grid (bicubic) ────────────────────
  const MGrid = griddata2DBicubic(HrIn, HaIn, MRaw, HrOut1D, HaOut1D);

  // ─── Step 5: Uniform-filter smoothing ────────────────────────────────────
  // SF is defined on the MEASUREMENT grid (FORCinel: a (2·SF+1)-point window),
  // so convert to output-grid pixels per axis; otherwise changing the output
  // grid silently changes the physical smoothing window.
  let MSmooth;
  if (smoothingFactor > 0){
    const dHrOut = (HrMax - HrMin) / (gridSize - 1);
    const dHaOut = (HaMax - HaMin) / (gridSize - 1);
    const winI = Math.max(1, Math.round((2*smoothingFactor + 1) * dHrNat / dHrOut));
    const winJ = Math.max(1, Math.round((2*smoothingFactor + 1) * dHaNat / dHaOut));
    MSmooth = uniformFilter2D(MGrid, [winI, winJ]);
  } else {
    MSmooth = copy2D(MGrid);
  }

  // ─── Step 6: Mixed second partial derivative → ρ ──────────────────────────
  const dHr = HrOut1D[1] - HrOut1D[0];
  const dHa = HaOut1D[1] - HaOut1D[0];
  const dM_dHr = gradient2D(MSmooth, dHr, 0);
  const d2M = gradient2D(dM_dHr, dHa, 1);
  // rho = -1 * (-0.5 * d2M) = 0.5 * d2M
  // (Python writes it in two separate steps; we match the same sign convention.)
  const rho = zeros2D(gridSize, gridSize);
  for (let i = 0; i < gridSize; i++){
    for (let j = 0; j < gridSize; j++){
      rho[i][j] = -1.0 * (-0.5 * d2M[i][j]);
    }
  }

  // ─── Step 7: Transform to (Hc, Hu) and build validity mask ───────────────
  const Hc = zeros2D(gridSize, gridSize);
  const Hu = zeros2D(gridSize, gridSize);
  const validMask = [];
  for (let i = 0; i < gridSize; i++){
    validMask.push(new Uint8Array(gridSize));
    for (let j = 0; j < gridSize; j++){
      Hc[i][j] = (HaGrid[i][j] - HrGrid[i][j]) / 2.0;
      Hu[i][j] = (HaGrid[i][j] + HrGrid[i][j]) / 2.0;
      validMask[i][j] = (HaGrid[i][j] >= HrGrid[i][j]) ? 1 : 0;
    }
  }

  // ─── Bu=0 registration is applied at DISPLAY time in tForcDiag: the contour
  //     resamples rho against the UNSHIFTED Hr/Ha grid, so shifting Hu here is
  //     bypassed. Hu is kept in raw coordinates for a consistent rho lookup. ─



  return {
    forcData: forc,
    HrGrid, HaGrid,
    MGrid, MSmooth,
    Hc, Hu,
    rho,
    validMask,
    smoothingFactor,
    gridSize,
  };
}


