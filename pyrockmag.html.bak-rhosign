    [0.30,'rgb(32,220,182)'], [0.40,'rgb(117,249,77)'], [0.50,'rgb(196,238,45)'],
    [0.60,'rgb(249,190,65)'], [0.70,'rgb(253,138,51)'], [0.80,'rgb(234,85,36)'],
    [0.90,'rgb(196,38,19)'],  [1.00,'rgb(122,4,3)']
  ]
};


// Build a Plotly contour trace for the FORC distribution.
// For FORC_DIAG the convention is: x = Hc (coercivity), y = Hu (interaction)
// with pixels outside the triangular valid region shown as transparent.
// We only support single-sample FORC diagrams (multi-sample makes no sense here).
function tForcDiag(samples){
  if (!samples || samples.length === 0) return [];
  // FORC diagrams are per-sample; use the first selected sample only.
  // Accept either bare RmgData or wrapper {name, samplename, data}.
  const raw = samples[0];
  if (!raw) return [];
  const d = raw.data || raw;
  const sName = raw.name || raw.samplename || d.samplename || 'sample';
  if (!d || (!d.steptypes && !(d.vsm && d.vsm.forcCurves))) return [];

  let result;
  try {
    result = processForcForcinelWorkflow(d, {
      smoothingFactor: ForcDiagState.smoothingFactor,
      gridSize: ForcDiagState.gridSize,
    });
  } catch(e){
    // Not enough FORC data — return empty; runPlot() will show empty-state message
    ForcDiagState.lastResult = null;
    return [];
  }
  ForcDiagState.lastResult = result;

  // Central-ridge diagnostic: |rho|-max Bu per 2.5 mT Bc bin over 10–40 mT,
  // median reported in the info line so any real field offset is visible.
  {
    const gsD = result.gridSize, bins = {};
    let rhoPk = 0;
    for (let i = 0; i < gsD; i++) for (let j = 0; j < gsD; j++){
      if (!result.validMask[i][j]) continue;
      const v = result.rho[i][j]; if (!Number.isFinite(v)) continue;
      if (Math.abs(v) > rhoPk) rhoPk = Math.abs(v);
      const bc = result.Hc[i][j] * 1000;
      if (bc < 10 || bc > 40) continue;
      const b = Math.round(bc / 2.5);
      if (!(b in bins) || Math.abs(v) > Math.abs(bins[b].v)) bins[b] = { v, bu: result.Hu[i][j] * 1000 };
    }
    const bus = Object.values(bins).map(x => x.bu).sort((a, b) => a - b);
    result.ridgeBuMT = bus.length ? bus[Math.floor(bus.length / 2)] : NaN;
    result.rhoPeak = rhoPk;
  }

  // Build flat x/y 1D coordinates for the contour. The Hc and Hu axes are NOT
  // rectangular in (Hr, Ha) index space. Plotly's contour trace requires:
  //   z:  2D matrix [iy][ix]
  //   x:  1D array of x-coordinates (one per column of z)
  //   y:  1D array of y-coordinates (one per row of z)
  // Since Hc and Hu are computed from Hr and Ha by rotation, we need to
  // resample rho onto a rectangular (Hc, Hu) grid.
  // Approach: grid-search nearest-neighbour. For gridSize N×N in (Hr, Ha),
  // the (Hc, Hu) diamond spans roughly [0, Hmax-Hmin/2]×[Hmin/2, Hmax/2].
  // We build an output grid of the same resolution and look up rho via the
  // inverse transform: (Hr, Ha) = (Hu - Hc, Hu + Hc).

  const gs = result.gridSize;
  const HrGrid = result.HrGrid;
  const HaGrid = result.HaGrid;
  const rho = result.rho;
  const Hc = result.Hc;
  const Hu = result.Hu;

  // Output Hc/Hu axes (1D, mT units for display)
  // Hc ranges from 0 to (HaMax - HrMin)/2; Hu ranges from HrMin/2 to HaMax/2.
  // Use symmetric Hu around 0 for nicer visualisation (clamp to data range).
  let HcMin = Infinity, HcMax = -Infinity, HuMin = Infinity, HuMax = -Infinity;
  let apexBu = 0, apexMinBc = Infinity;   // Bu of the min-Bc vertex = left apex (registration ref)
  for (let i = 0; i < gs; i++){
    for (let j = 0; j < gs; j++){
      if (!result.validMask[i][j]) continue;
      const hc = Hc[i][j], hu = Hu[i][j];
      if (hc < HcMin) HcMin = hc;
      if (hc > HcMax) HcMax = hc;
      if (hu < HuMin) HuMin = hu;
      if (hu > HuMax) HuMax = hu;
      if (hc < apexMinBc){ apexMinBc = hc; apexBu = hu; }
    }
  }

  // Symmetric Hu clamp for nicer visualization
  const HuAbs = Math.max(Math.abs(HuMin), Math.abs(HuMax));
  HuMin = -HuAbs;
  HuMax = HuAbs;

  // Output grid same resolution as input
  const Hc_1d = new Float64Array(gs);
  const Hu_1d = new Float64Array(gs);
  // Anchor the Hu grid so one node lands exactly on the apex Bu — guarantees the
  // left apex renders precisely at display Bu=0 with no grid-quantisation residual.
  const huStep = (HuMax - HuMin) / (gs - 1);
  const nApex = Math.round((apexBu - HuMin) / huStep);
  for (let k = 0; k < gs; k++){
    Hc_1d[k] = HcMin + (HcMax - HcMin) * k / (gs - 1);
    Hu_1d[k] = apexBu + (k - nApex) * huStep;
  }

  // Resample rho onto (Hc, Hu) via inverse transform
  // (Hr, Ha) = (Hu - Hc, Hu + Hc)
  // Then bilinear-interpolate rho[i][j] at that (Hr, Ha) location.
  const HrMin = HrGrid[0][0], HrMax = HrGrid[gs-1][0];
  const HaMin = HaGrid[0][0], HaMax = HaGrid[0][gs-1];
  const dHrG = (HrMax - HrMin) / (gs - 1);
  const dHaG = (HaMax - HaMin) / (gs - 1);

  // z array shape is [Hu][Hc] → [y][x] for Plotly
  const z = new Array(gs);
  for (let yi = 0; yi < gs; yi++){
    z[yi] = new Array(gs);
    const hu = Hu_1d[yi];
    for (let xi = 0; xi < gs; xi++){
      const hc = Hc_1d[xi];
      const hr = hu - hc;
      const ha = hu + hc;
      // Check in valid range
      if (hr < HrMin || hr > HrMax || ha < HaMin || ha > HaMax || ha < hr){
        z[yi][xi] = null;   // transparent
        continue;
      }
      // Bilinear interpolate rho at (hr, ha) in the rho grid (indexed i=Hr, j=Ha)
      const fi = (hr - HrMin) / dHrG;
      const fj = (ha - HaMin) / dHaG;
      const i0 = Math.floor(fi), j0 = Math.floor(fj);
      const i1 = Math.min(i0 + 1, gs - 1);
      const j1 = Math.min(j0 + 1, gs - 1);
      const ti = fi - i0, tj = fj - j0;
      if (i0 < 0 || j0 < 0){ z[yi][xi] = null; continue; }
      const v00 = rho[i0][j0], v01 = rho[i0][j1], v10 = rho[i1][j0], v11 = rho[i1][j1];
      if (!Number.isFinite(v00) || !Number.isFinite(v01) || !Number.isFinite(v10) || !Number.isFinite(v11)){
        z[yi][xi] = null;
        continue;
      }
      const top    = v00 * (1 - tj) + v01 * tj;
      const bottom = v10 * (1 - tj) + v11 * tj;
      z[yi][xi] = top * (1 - ti) + bottom * ti;
    }
  }

  // Compute symmetric colour scale based on ρ magnitude in the valid region
  let absMax = 0;
  for (let yi = 0; yi < gs; yi++){
    for (let xi = 0; xi < gs; xi++){
      const v = z[yi][xi];
      if (v !== null && Math.abs(v) > absMax) absMax = Math.abs(v);
    }
  }

  // Convert Hc/Hu to mT for display.
  // Apex registration (shift so the low-Bc vertex sits at Bu=0) is only
  // meaningful for the 2G triangular grid, where that vertex is unique.
  // MicroMag/VSM grids have Bc≈0 cells all along the Ha≈Hr diagonal, so the
  // "apex" is an arbitrary cell — skip the shift and show raw Bu instead.
  const buShift = (d && d.vsm) ? 0 : apexBu;
  const x_mT = Array.from(Hc_1d).map(v => v * 1000);
  const y_mT = Array.from(Hu_1d).map(v => (v - buShift) * 1000);   // left apex → Bu=0 (2G only)

  // User-selected colormap from the FORC controls dropdown. Falls back to inferno_r.
  const colorscale = FORC_COLORMAPS[ForcDiagState.colormap] || FORC_COLORMAPS['inferno_r'];

  // Compute z range from valid cells, clipped to robust percentiles
  // [0.5%, 99.5%]. Raw min/max lets a single interpolation spike at the
  // diamond edge (common with irregular MicroMag grids) own the whole color
  // scale and wash out the central ridge; percentile clipping is standard
  // FORC display practice and leaves well-behaved (2G) data essentially unchanged.
  const zvals = [];
  for (let yi = 0; yi < gs; yi++){
    for (let xi = 0; xi < gs; xi++){
      const v = z[yi][xi];
      if (v !== null && Number.isFinite(v)) zvals.push(v);
    }
  }
  zvals.sort((a, b) => a - b);
  let zMin = Infinity, zMax = -Infinity;
  if (zvals.length){
    zMin = zvals[Math.max(0, Math.floor(0.005 * (zvals.length - 1)))];
    zMax = zvals[Math.min(zvals.length - 1, Math.ceil(0.995 * (zvals.length - 1)))];
  }
  // Guard against degenerate range
  if (!Number.isFinite(zMin) || !Number.isFinite(zMax) || zMin === zMax){
    zMin = -1e-9; zMax = 1e-9;
  }

  return [{
    type: 'contour',
    z: z,
    x: x_mT,
    y: y_mT,
    colorscale: colorscale,
    zmin: zMin,
    zmax: zMax,
    zauto: false,
    contours: { coloring: 'fill', showlabels: false },
    ncontours: 20,
    colorbar: { title: { text: 'Am²/T²', side: 'right' }, thickness: 14, len: 0.85, exponentformat: 'power' },
    connectgaps: false,
    name: sName,
    hovertemplate: 'B<sub>c</sub>=%{x:.1f} mT<br>B<sub>u</sub>=%{y:.1f} mT<br>ρ=%{z:.3e}<extra></extra>',
  }];
}


// ─── FORC hysteresis overlay (M vs field, all reversal curves) ──────────────
// Ports rmg_forc.py::plot_forc_hysteresis_complete. Uses the "complete" extraction
// which includes the reversal point (Hr, Mr) so each curve renders as a full curve.
function tForcHyst(samples){
  const traces = [];
  if (!samples || samples.length === 0) return traces;

  for (let si = 0; si < samples.length; si++){
    const raw = samples[si];
    if (!raw) continue;
    // Accept either bare RmgData or wrapper {name, samplename, data}
    const d = raw.data || raw;
    const sName = raw.name || raw.samplename || d.samplename || `sample${si+1}`;
    if (!d || (!d.steptypes && !(d.vsm && d.vsm.forcCurves))) continue;
    const forc = rmgExtractForcDataComplete(d);
    if (!forc.exists) continue;

    const nCurves = forc.curves.length;
    let totalPoints = 0;
    // Single blue colour at low alpha, matching rmg_forc.plot_forc_hysteresis_complete
    const color = 'rgba(0, 0, 255, 0.55)';

    for (let ci = 0; ci < nCurves; ci++){
      const c = forc.curves[ci];

      // Keep fields in Tesla (NOT mT) — matches the Python reference
      const xs = [c.Hr].concat(Array.from(c.Ha));
      const ys = [c.Mr].concat(Array.from(c.M));
      totalPoints += xs.length;

      traces.push({
        type: 'scatter',
        mode: 'lines+markers',
        x: xs,
        y: ys,
        line: { color, width: 0.5 },
        marker: { color, size: 2.5 },
        name: ci === 0 ? `${sName} (${nCurves} curves, ${ /* filled below */ 0})` : '',
        legendgroup: `forc-hyst-${si}`,
        showlegend: ci === 0,
        hovertemplate: `Hr=${c.Hr.toFixed(4)} T<br>B=%{x:.4f} T<br>M=%{y:.3e} Am²<extra></extra>`,
      });
    }
    // Patch in the real "Curves: N / Points: M" name on the first trace of this sample
    const firstOfSample = traces.filter(t => t.legendgroup === `forc-hyst-${si}`)[0];
    if (firstOfSample){
      firstOfSample.name = `${sName} — Curves: ${nCurves} / Points: ${totalPoints}`;
    }
    // Stash totals on the first trace for layout annotation
    traces._forcHystInfo = traces._forcHystInfo || [];
    traces._forcHystInfo.push({ name: d.samplename || sName, curves: nCurves, points: totalPoints });
  }
  return traces;
}


// ─── RRM and MPMS trace builders ────────────────────────────────────────────
function tRRM(samples, useMag){
  const tr = [];
  const L = document.documentElement.classList.contains('light');
  const C = L ? ['#b3301a','#0d4a8a','#6b5310','#5c2278','#0f7a3c','#9c1560']
              : ['#f87171','#60a5fa','#fbbf24','#c084fc','#4ade80','#f472b6'];
  samples.forEach((d, i) => {
    const blocks = rmgRrmCurve(d);
    if(!blocks.length) return;
    // merge the rotation senses into one curve through zero
    const pts = [];
    for(const b of blocks){
      for(let k=0;k<b.spin.length;k++){
        const y = useMag ? b.mag[k] : b.mz[k];
        if(isFinite(b.spin[k]) && isFinite(y)) pts.push([b.spin[k], y]);
      }
    }
    pts.sort((a,b) => a[0]-b[0]);
    tr.push({
      x: pts.map(p=>p[0]), y: pts.map(p=>p[1]),
      mode:'lines+markers', type:'scatter',
      name: (d.samplename||('sample '+(i+1))) + (useMag ? ' |M|' : ' Mz'),
      line:{color:C[i%C.length], width:1.6},
      marker:{size:4, color:C[i%C.length]}
    });
  });
  return tr;
}

function tMpmsLowT(samples){
  const tr = [];
  const L = document.documentElement.classList.contains('light');
  const C = L ? ['#b3301a','#0d4a8a','#6b5310','#5c2278']
              : ['#f87171','#60a5fa','#fbbf24','#c084fc'];
  let ci = 0;
  samples.forEach(d => {
    if(!d.mpms) return;
    d.mpms.legs.forEach(leg => {
      if(leg.inField || leg.T.length < 20) return;
      const m0 = leg.M[0] || 1;
      tr.push({
        x: leg.T, y: leg.M.map(v => v/m0),
        mode:'lines', type:'scatter',
        name: (d.samplename||'sample') + ' ' + leg.direction,
        line:{color:C[ci%C.length], width:1.8}
      });
      if(leg.rejectedT.length){
        tr.push({
          x: leg.rejectedT, y: leg.rejectedM.map(v => v/m0),
          mode:'markers', type:'scatter', name:'rejected outlier',
          marker:{size:7, symbol:'x', color:'#888888'}, showlegend:true
        });
      }
      ci++;
    });
  });
  // reference lines for the two transitions this plot exists to look for
  if(tr.length){
    for(const [x, lab] of [[120,'Verwey (magnetite)'],[34,'Besnus (pyrrhotite)']]){
      tr.push({ x:[x,x], y:[0,1.05], mode:'lines', type:'scatter', name:lab,
                line:{color:'#888888', width:1, dash:'dot'}, hoverinfo:'name' });
    }
  }
  return tr;
}

function tMpmsDeriv(samples){
  const tr = [];
  const L = document.documentElement.classList.contains('light');
  const C = L ? ['#b3301a','#0d4a8a'] : ['#f87171','#60a5fa'];
  let ci = 0;
  samples.forEach(d => {
    if(!d.mpms) return;
    d.mpms.legs.forEach(leg => {
      if(leg.inField || leg.T.length < 40) return;
      const m0 = leg.M[0] || 1;
      const T = leg.T, Mn = leg.M.map(v => v/m0);
      const dv = [];
      for(let i=1;i<T.length-1;i++){
        const dT = T[i+1]-T[i-1];
        dv.push(dT !== 0 ? -(Mn[i+1]-Mn[i-1])/dT : NaN);
      }
      // 9-point boxcar, matching the smoothing used elsewhere in the app
      const w = 9, half = (w-1)/2, sm = [];
      for(let i=0;i<dv.length;i++){
        let a = 0, c = 0;
        for(let j=Math.max(0,i-half); j<=Math.min(dv.length-1,i+half); j++){
          if(isFinite(dv[j])){ a += dv[j]; c++; }
        }
        sm.push(c ? a/c : NaN);
      }
      tr.push({
        x: T.slice(1,-1), y: sm.map(v => v*1e3),
        mode:'lines', type:'scatter',
        name: (d.samplename||'sample') + ' ' + leg.direction,
        line:{color:C[ci%C.length], width:1.6}
      });
      ci++;
    });
  });
  return tr;
}

// Dispatch to correct trace builder
function buildTraces(samples, op){
  switch(op.toUpperCase()){
    case 'IRM':       return tIRM(samples);
    case 'DIRM':      return tDIRM(samples);
    case 'ARM':       return tARM(samples);
    case 'LF':        return tLF(samples, false);
    case 'LF_ARM':    return tLF(samples, true);
    case 'FULLER':    return tFuller(samples);
    case 'BACKFIELD': return tBackfield(samples);
    case 'NRM_DEMAG':  return tNrmDemag(samples);
    case 'COERCIVITY':return tCoercivity(samples);
    case 'FORC_CURVES': return tForcCurves(samples);
    case 'FORC_DCD':      return tForcDcd(samples);
    case 'FORC_COERSPEC': return tForcCoer(samples);
    case 'FORC_IRMACQ':   return tForcIrmAcq(samples);
    case 'HYST_LOOP':     return tHystLoop(samples);
    case 'DCD_CURVE':     return tDcdCurve(samples);
    case 'DAY':           return tDayDiagram(samples);
    case 'TABLE':         return tDayTable(samples);
    case 'RRM':         return tRRM(samples, false);
    case 'RRM_MAG':     return tRRM(samples, true);
    case 'MPMS_LOWT':   return tMpmsLowT(samples);
    case 'MPMS_DERIV':  return tMpmsDeriv(samples);
    case 'THERM_DECAY': return tThermDecay(samples);
    case 'DEMAG_COMP':  return tDemagComp(samples);
    case 'ZIJD':        return tZij(samples);
    case 'PCA_FITS':    return tZij(samples);
    case 'LSQ_TABLE':   return tLsqTable(samples);
    case 'EQAREA':      return tEqArea(samples);
    case 'UCHAN_DEPTH': return tUchanDepth(samples);
    case 'XT_CURVE':    return tXtCurve(samples);
    case 'FORC_DIAG':   return tForcDiag(samples);
    case 'FORC_HYST':   return tForcHyst(samples);
    default: return [];
  }
}

// ── Plot captions (educational text) ─────────────────────────────────────────
const CAPTIONS = {
  'RRM': {
    title: 'Rotational remanent magnetisation',
    axes:  'x: rotation rate (rps)  ·  y: M<sub>z</sub> (Am<sup>2</sup>)',
    interp: 'RRM is acquired by rotating the specimen in an alternating field. The defining test is that the remanence <b>reverses sign with the sense of rotation</b>; a curve that is antisymmetric through the origin is a real RRM rather than a stray ARM. Magnitude grows with rotation rate before levelling off. A large RRM relative to ARM is characteristic of greigite.'
  },
  'MPMS_LOWT': {
    title: 'Low-temperature remanence',
    axes:  'x: temperature (K)  ·  y: M normalised to the start of the leg',
    interp: 'Warming a low-temperature remanence in zero field. A step near 120 K is the Verwey transition of magnetite; a step near 34 K is the Besnus transition of monoclinic pyrrhotite. Greigite has no low-temperature transition, so a smooth monotonic decay with neither step points away from both minerals.'
  },
  'MPMS_DERIV': {
    title: 'Temperature derivative',
    axes:  'x: temperature (K)  ·  y: -d(M/M<sub>start</sub>)/dT',
    interp: 'The derivative of the warming curve. A transition appears here as a peak; a featureless monotonic rise means no transition. Single-point dropouts are rejected before differentiating, since one bad point produces a spike indistinguishable from a transition.'
  },
  'IRM': {
    title: 'IRM acquisition + AF demagnetisation',
    axes:  'x: applied field B (log mT)  ·  y: f<sub>SIRM</sub> = M / M<sub>final</sub>',
    interp: 'Rising curve = IRM acquisition. Falling curve = AF demagnetisation of sIRM. Where they cross ≈ H<sub>cr</sub>. Steeper acquisition → lower coercivity (magnetite). Gentle, extended rise → high coercivity (hematite, goethite).'
  },
  'DIRM': {
    title: 'dIRM/dB — coercivity spectrum',
    axes:  'x: field B (log mT)  ·  y: dIRM/d(log B) — normalised first derivative',
    interp: 'Each peak identifies one magnetic component. Peak near 20-50 mT = magnetite SD/PSD. 100-300 mT = hematite/goethite. Peak width (DP) indicates grain-size distribution.'
  },
  'ARM': {
    title: 'ARM acquisition vs. DC bias',
    axes:  'x: B<sub>DC</sub> (mT, linear 0-1)  ·  y: fIRM100 = ARM / sIRM',
    interp: 'Slope = ARM susceptibility (k<sub>ARM</sub>). Compare to Chiton (SD) and MS1 (PSD) reference curves. Higher slope = more single-domain or interacting SD grains. Departure from tanh shape = grain-size effects.'
  },
  'LF': {
    title: 'Lowrie-Fuller test — AF demagnetisation of ARM vs IRM',
    axes:  'x: AF field B (mT)  ·  y: fractional magnetisation M/M<sub>0</sub>',
    interp: 'ARM decays faster than IRM → large multi-domain grains (MD). ARM decays slower than IRM → SD grains dominate. Parallel curves = mixed assemblage.'
  },
  'LF_ARM': {
    title: 'Lowrie-Fuller — ARM component only',
    axes:  'x: AF field B (mT)  ·  y: fractional ARM mag.',
    interp: 'Median destructive field (MDF) of ARM is where the curve crosses 0.5. Higher MDF = more SD-like behaviour.'
  },
  'FULLER': {
    title: 'Fuller plot — NRM/ARM vs IRM',
    axes:  'x: IRM (log Am²)  ·  y: m (log Am²) at equivalent AF',
    interp: 'Slope ≈ 1 = expected behaviour for TRM-like NRM. NRM/sIRM ratio ≈ 10⁻³ to 10⁻² for typical geological samples. Useful for palaeointensity estimation.'
  },
  'BACKFIELD': {
    title: 'Backfield IRM — DC demagnetisation',
    axes:  'x: −B (mT)  ·  y: M (Am²)',
    interp: 'Where the curve crosses zero = H<sub>cr</sub> (coercivity of remanence). This is the most robust single coercivity parameter.'
  },
  'COERCIVITY': {
    title: 'Coercivity comparison',
    axes:  'bars per sample',
    interp: 'H<sub>cr</sub> (from IRM acq/AF crossover) and MDF<sub>IRM</sub> (50% point of AF curve) should agree for simple samples. Large divergence = component mixture.'
  },
  'FORC_CURVES': {
    title: 'FORC raw curves — M vs Ha',
    axes:  'x: applied field H<sub>a</sub> (mT)  ·  y: magnetisation M (Am²)',
    interp: 'Each curve is one reversal: after saturating to negative Hr, the field sweeps back up through zero. Curves should rise smoothly and share a common saturation point. Noisy or crossing curves indicate measurement drift or an unsettled sample. Colour gradient (blue→red) indicates deepest→shallowest Hr.'
  },
  'FORC_DIAG': {
    title: 'FORC diagram — ρ(Bc, Bu) in Am²/T²',
    axes:  'x: coercivity B<sub>c</sub>=(H<sub>a</sub>−H<sub>r</sub>)/2  ·  y: interaction field B<sub>u</sub>=(H<sub>a</sub>+H<sub>r</sub>)/2  (mT)  ·  inferno_r colormap (bright = strongest signal)',
    interp: 'ρ = −½·∂²M/∂H<sub>r</sub>∂H<sub>a</sub>. Peaks along the B<sub>c</sub> axis at B<sub>u</sub>=0 indicate non-interacting SD grains. A vertical spread in B<sub>u</sub> shows magnetostatic interactions. A ridge near B<sub>c</sub>=0 extending in B<sub>u</sub> is the signature of MD / vortex behaviour. FORCinel-style smoothing factor SF trades noise for resolution (2-4 typical). Only the H<sub>a</sub>≥H<sub>r</sub> region is physical; outside is masked.'
  },
  'FORC_HYST': {
    title: 'FORC hysteresis — full M vs field for every reversal curve',
    axes:  'x: field B (T)  ·  y: remanence (Am²)',
    interp: 'Each reversal curve plotted as a full hysteresis trace including the reversal point (Hr, Mr). The envelope shows the major hysteresis loop; interior traces show reversal behaviour. Gaps along the envelope indicate missing curves; noisy traces suggest instrument drift. Curves/points count shown in top-left box.'
  }
};




// ═════════════════════════════════════════════════════════════════════════════
// pyRockmag JS port — SAM UTILITIES
// Ports mk_sam_utilities.py (Swanson-Hysell / PmagPy lineage):
//   - igrf()               IGRF-13 wrapper → [Dec, Inc, F]
//   - doigrf()             coefficient selection + magsyn
//   - magsyn()             Malin & Barraclough spherical harmonic synthesis
//   - cart2dir()           xyz → [Dec, Inc, R]
//   - sundec()             sun compass → azimuth wrt true north
//   - gha()                Greenwich hour angle + solar declination
//   - julian()             calendar → Julian day
//   - toYearFraction()     Date → decimal year
//
// Validated against ppigrf (standard IGRF-13) to <0.03° on Dec/Inc across
// worldwide test locations.
// ═════════════════════════════════════════════════════════════════════════════

