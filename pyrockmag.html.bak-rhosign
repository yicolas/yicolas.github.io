    closeRunModal();
  }
});

// ── Splitters ────────────────────────────────────────────────────────────────
(function(){
  function initSplitter(spId, colVar){
    const sp = document.getElementById(spId);
    if(!sp) return;
    let startX, startW;
    sp.addEventListener('mousedown', e => {
      e.preventDefault();
      startX = e.clientX;
      const st = getComputedStyle(document.documentElement);
      startW = parseInt(st.getPropertyValue(colVar).trim()) || (colVar==='--c1'?270:200);
      sp.classList.add('dragging');
      function onMove(e){
        const dx = e.clientX - startX;
        document.documentElement.style.setProperty(colVar, Math.max(140, startW + dx) + 'px');
        requestAnimationFrame(() => {
          const pd = document.getElementById('plotly-div');
          if(pd && pd.classList.contains('vis')) Plotly.Plots.resize(pd);
          if(S.dashVis) for(let i=0;i<5;i++){
            const c = document.getElementById('d'+i);
            if(c) Plotly.Plots.resize(c);
          }
        });
      }
      function onUp(){
        sp.classList.remove('dragging');
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  }
  initSplitter('sp1','--c1');
  initSplitter('sp2','--c2');
})();

// ── Go ───────────────────────────────────────────────────────────────────────


// ─── SAM generator ────────────────────────────────────────────────────────────
const SamState = { rows: [] };

function showSamModal(){
  // Default date = today
  const today = new Date();
  const iso = today.toISOString().slice(0, 10);
  if(!document.getElementById('sam-date').value) document.getElementById('sam-date').value = iso;
  if(SamState.rows.length === 0) samAddRows(3);
  samSetAlert(null, '');
  document.getElementById('sam-preview').style.display = 'none';
  document.getElementById('sam-ov').classList.add('vis');
}
function hideSamModal(){ document.getElementById('sam-ov').classList.remove('vis'); }

function samSetAlert(type, msg, details){
  const bar = document.getElementById('sam-alert-bar');
  if(!msg){ bar.style.display = 'none'; return; }
  let bg, border, color, icon;
  switch(type){
    case 'error':   bg='rgba(239,83,80,.12)'; border='var(--red)'; color='var(--red)'; icon='✗'; break;
    case 'warn':    bg='rgba(255,213,79,.12)'; border='var(--amb)'; color='var(--amb)'; icon='⚠'; break;
    case 'info':    bg='rgba(143,168,164,.10)'; border='var(--bdr2)'; color='var(--tx2)'; icon='ℹ'; break;
    case 'success':
    default:        bg='rgba(0,230,118,.10)'; border='var(--ac2)'; color='var(--ac2)'; icon='✓';
  }
  bar.style.background = bg;
  bar.style.borderTop = '2px solid ' + border;
  bar.style.color = color;
  bar.innerHTML = `<span style="font-weight:600;margin-right:8px">${icon}</span>${msg}` + (details ? `<div style="margin-top:4px;font-size:10px;color:var(--tx3)">${details}</div>` : '');
  bar.style.display = 'block';
}


function samAddRow(data){
  SamState.rows.push(Object.assign({
    name: '', shadowAngle: '', time: '', gmtOffset: '',
    magStrike: '', coreDip: '', bedStrike: '', bedDip: '',
    mass: '', stratLevel: '0',
  }, data || {}));
  renderSamRows();
}
function samAddRows(n){
  for(let i=0;i<n;i++) samAddRow({ name: String(SamState.rows.length + i + 1) });
}
function samClearRows(){ SamState.rows = []; renderSamRows(); }

function renderSamRows(){
  const tb = document.getElementById('sam-tbody');
  tb.innerHTML = '';
  SamState.rows.forEach((r, i) => {
    const tr = document.createElement('tr');
    tr.style.borderTop = '1px solid var(--bdr)';
    const inp = (field, width, type, step) => {
      const widthStyle = width || '100%';
      const t = type || 'text';
      const stepAttr = step ? ` step="${step}"` : '';
      return `<td style="padding:2px"><input type="${t}"${stepAttr} value="${r[field] ?? ''}" data-field="${field}" data-row="${i}" style="width:${widthStyle};background:var(--bg3);border:1px solid var(--bdr);color:var(--tx);padding:3px 5px;border-radius:3px;font-family:var(--mono);font-size:10px"></td>`;
    };
    tr.innerHTML = inp('name', '70px')
                 + inp('shadowAngle', '60px', 'number', '0.1')
                 + inp('time', '60px', 'time')
                 + inp('gmtOffset', '40px', 'number', '1')
                 + inp('magStrike', '60px', 'number', '0.1')
                 + inp('coreDip', '60px', 'number', '0.1')
                 + inp('bedStrike', '60px', 'number', '0.1')
                 + inp('bedDip', '60px', 'number', '0.1')
                 + inp('mass', '60px', 'number', '0.01')
                 + inp('stratLevel', '60px', 'number', '0.1')
                 + `<td style="padding:2px;text-align:center"><span class="x" style="color:var(--tx3);cursor:pointer;padding:2px 6px" data-del="${i}">×</span></td>`;
    tb.appendChild(tr);
  });
  // Wire inputs
  tb.querySelectorAll('input').forEach(el => {
    el.oninput = () => {
      const i = parseInt(el.dataset.row);
      SamState.rows[i][el.dataset.field] = el.value;
    };
  });
  tb.querySelectorAll('[data-del]').forEach(el => {
    el.onclick = () => {
      SamState.rows.splice(parseInt(el.dataset.del), 1);
      renderSamRows();
    };
  });
}

// Parse row → sample object for calculateOrientation()
function samParseRow(r, site, defaultDate, defaultGmt){
  const sample = {
    name: r.name || '',
    comment: '',
    stratLevel: parseFloat(r.stratLevel) || 0,
    coreDip: parseFloat(r.coreDip) || 0,
    magCoreStrike: r.magStrike !== '' ? parseFloat(r.magStrike) : null,
    bedStrike: parseFloat(r.bedStrike) || 0,
    bedDip: parseFloat(r.bedDip) || 0,
    mass: parseFloat(r.mass) || 1.0,
    correctBedding: true,
  };
  // Sun compass: shadow angle + time
  if(r.shadowAngle !== '' && r.time){
    sample.shadowAngle = parseFloat(r.shadowAngle);
    // Build Date from defaultDate + time
    const [hh, mm] = r.time.split(':').map(Number);
    const d = new Date(defaultDate);
    d.setHours(hh, mm || 0, 0, 0);
    sample.dateTime = d;
    sample.gmtOffset = r.gmtOffset !== '' ? parseInt(r.gmtOffset) : defaultGmt;
  } else {
    sample.shadowAngle = null;
    // Still need a date for IGRF
    sample.dateTime = defaultDate;
    sample.gmtOffset = defaultGmt;
  }
  return sample;
}

function samReadForm(){
  const siteId = document.getElementById('sam-siteid').value.trim().slice(0, 8);
  if(!siteId) throw new Error('Site ID is required (max 8 chars)');
  const site = {
    siteId,
    siteName: document.getElementById('sam-sitename').value.trim() || siteId,
    lat: parseFloat(document.getElementById('sam-lat').value) || 0,
    lon: parseFloat(document.getElementById('sam-lon').value) || 0,
    elevation: parseFloat(document.getElementById('sam-elev').value) || 0,
  };
  const defaultDate = new Date(document.getElementById('sam-date').value);
  if(isNaN(defaultDate.getTime())) throw new Error('Invalid date');
  const defaultGmt = parseInt(document.getElementById('sam-gmt').value) || 0;
  const preferSun = document.getElementById('sam-prefer').value === 'yes';
  return { site, defaultDate, defaultGmt, preferSun };
}

function samCalculate(){
  try {
    const { site, defaultDate, defaultGmt, preferSun } = samReadForm();
    if(SamState.rows.length === 0){ throw new Error('Add at least one sample'); }

    const calculated = SamState.rows.map(r => {
      const sample = samParseRow(r, site, defaultDate, defaultGmt);
      return calculateOrientation(sample, site, { preferSun });
    });

    // Build preview text
    let preview = '';
    preview += `== site ${site.siteId} (${site.lat.toFixed(3)}°, ${site.lon.toFixed(3)}°) ==\n`;
    preview += `\n=== .sam header file ===\n`;
    preview += writeSamHeader(site, calculated);
    let hasWarnings = false;
    preview += `\n=== sample orientations ===\n`;
    calculated.forEach((s, i) => {
      const sunStr = s.sunCoreStrike !== null ? s.sunCoreStrike.toFixed(1) + '°' : '—';
      const igrfStr = s.igrfDec !== null ? s.igrfDec.toFixed(2) + '°' : '—';
      preview += `${s.name.padEnd(8)}  sun=${sunStr.padEnd(8)}  igrf=${igrfStr.padEnd(8)}  final_strike=${s.coreStrike.toFixed(1)}°  ` + s.comment + '\n';
      if(s.warning){ preview += '  ⚠ ' + s.warning + '\n'; hasWarnings = true; }
    });

    document.getElementById('sam-preview-text').textContent = preview;
    document.getElementById('sam-preview').style.display = 'block';
    const warns = calculated.filter(s => s.warning);
    if(hasWarnings){
      samSetAlert('warn',
        `${calculated.length} samples calculated — ${warns.length} warning(s), review before downloading`,
        warns.map(s => `<b>${s.name}</b>: ${s.warning}`).join('<br>'));
    } else {
      samSetAlert('success', `${calculated.length} samples calculated, no warnings`);
    }

    // Stash for download
    SamState._lastCalculated = { site, samples: calculated };
  } catch(e){
    samSetAlert('error', e.message);
  }
}

function samDownload(){
  try {
    if(!SamState._lastCalculated) samCalculate();
    if(!SamState._lastCalculated) return;
    const { site, samples } = SamState._lastCalculated;

    // Validate 8.3 naming first
    const validation = [];
    for(const s of samples){
      const v = validateSamNaming(site.siteId, s.name.startsWith(site.siteId) ? s.name.slice(site.siteId.length) : s.name, '');
      if(!v.ok) validation.push(`${s.name}: ${v.warn}`);
    }
    if(validation.length > 0){
      const msg = 'Filename 8.3 format issues:\n' + validation.join('\n');
      if(!confirm(msg + '\n\nContinue anyway?')) return;
    }

    // Build files dict
    const files = {};
    files[site.siteId + '.sam'] = writeSamHeader(site, samples);
    for(const s of samples){
      const sampleId = s.name.startsWith(site.siteId) ? s.name : site.siteId + s.name;
      files[sampleId] = writeSamSampleFile(site, s);
    }
    const zipBytes = buildZipArchive(files);
    const blob = new Blob([zipBytes], { type: 'application/zip' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${site.siteId}_sam.zip`;
    a.click();
    URL.revokeObjectURL(a.href);
    samSetAlert('success', `downloaded ${site.siteId}_sam.zip (${Object.keys(files).length} files)`);
  } catch(e){
    samSetAlert('error', e.message);
  }
}

// ─── FORC script generator ────────────────────────────────────────────────────

// ─── FORC modal tab switching ────────────────────────────────────────────────
function forcSwitchTab(tab){
  const tabGen = document.getElementById('forc-tab-gen');
  const tabConv = document.getElementById('forc-tab-conv');
  const panelGen = document.getElementById('forc-panel-gen');
  const panelConv = document.getElementById('forc-panel-conv');
  const preview = document.getElementById('forc-action-preview');
  const dl = document.getElementById('forc-action-dl');
  if(!tabGen || !tabConv) return;

  if(tab === 'gen'){
    tabGen.style.background = 'var(--bg3)';
    tabGen.style.color = 'var(--ac)';
    tabGen.style.borderColor = 'var(--bdr)';
    tabGen.style.borderBottomColor = 'transparent';
    tabConv.style.background = 'transparent';
    tabConv.style.color = 'var(--tx3)';
    tabConv.style.borderColor = 'transparent';
    panelGen.style.display = 'block';
    panelConv.style.display = 'none';
    preview.textContent = 'preview count';
    preview.onclick = forcPreviewCount;
    dl.textContent = 'download .rmg';
    dl.onclick = forcDownload;
  } else {
    tabConv.style.background = 'var(--bg3)';
    tabConv.style.color = 'var(--ac)';
    tabConv.style.borderColor = 'var(--bdr)';
    tabConv.style.borderBottomColor = 'transparent';
    tabGen.style.background = 'transparent';
    tabGen.style.color = 'var(--tx3)';
    tabGen.style.borderColor = 'transparent';
    panelGen.style.display = 'none';
    panelConv.style.display = 'block';
    preview.textContent = 'preview';
    preview.onclick = frcConvPreview;
    dl.textContent = 'download .frc';
    dl.onclick = frcConvDownload;
    refreshFrcSamplePicker();
  }
  document.getElementById('forc-result').textContent = '';
}

function refreshFrcSamplePicker(){
  const sel = document.getElementById('frc-src-sample');
  if(!sel) return;
  sel.innerHTML = '<option value="">— select a loaded sample with FORC data —</option>';
  if(!S || !S.samples) return;
  for(let i = 0; i < S.samples.length; i++){
    const s = S.samples[i];
    if(!s || !s.data) continue;
    const hasForc = s.data.steptypes && s.data.steptypes.some(t => {
      const l = (t || '').toLowerCase();
      return l === 'forcz' || l === 'irmz' || l === 'irm';
    });
    if(!hasForc) continue;
    const opt = document.createElement('option');
    opt.value = String(i);
    opt.textContent = s.name;
    sel.appendChild(opt);
  }
  const first = sel.options[1];
  if(first){
    const fn = document.getElementById('frc-fn');
    if(fn && (!fn.value || fn.value === 'sample.frc')){
      const name = S.samples[parseInt(first.value)].name.replace(/\.rmg$/i, '').replace(/[^A-Za-z0-9_-]/g, '_');
      fn.value = name + '.frc';
    }
  }
}

function frcConvGetOpts(){
  const selIdx = parseInt(document.getElementById('frc-src-sample').value);
  if(!Number.isFinite(selIdx)) throw new Error('Select a sample first');
  const sample = S.samples[selIdx];
  if(!sample || !sample.data) throw new Error('Sample not loaded');
  const multiplier = parseFloat(document.getElementById('frc-mult').value) || 1;
  return { sample, multiplier };
}

function frcConvPreview(){
  try {
    const { sample, multiplier } = frcConvGetOpts();
    const frcText = convertRmgToFrc(sample.data, { multiplier });
    const lines = frcText.split('\r');
    const head = lines.slice(0, 10).join('\n');
    document.getElementById('frc-preview').style.display = 'block';
    document.getElementById('frc-preview-text').textContent = head + '\n… (' + lines.length + ' lines total)';
    document.getElementById('forc-result').style.color = 'var(--ac2)';
    document.getElementById('forc-result').textContent = '✓ ' + lines.length + ' lines, ' + frcText.length + ' bytes';
  } catch(e){
    document.getElementById('forc-result').style.color = 'var(--red)';
    document.getElementById('forc-result').textContent = '✗ ' + e.message;
  }
}

/* ═════ MagIC (data model 3.0) export ══════════════════════════════════════
   Exports selected samples as one MagIC upload-ready text file containing a
   minimal specimens table plus a measurements table. Units per the data
   model: fields in Tesla, temperatures in Kelvin, moments in Am².
   Location/site/sample metadata is not known to the app — add those tables
   in the MagIC online editor after upload. */
function magicFmt(v){ return (typeof v === 'number' && isFinite(v)) ? String(+v.toPrecision(7)) : ''; }

function magicRowsForSample(d, seqStart){
  const spec = (d.samplename || 'specimen').replace(/\t/g, ' ');
  const rows = [];   // objects with magic column keys
  const lps = new Set();
  let seq = seqStart;
  const push = (o) => { o.specimen = spec; o.sequence = seq++; o.standard = 'u'; o.quality = 'g';
                        o.citations = 'This study'; rows.push(o); };

  if(d.mpms){
    for(const leg of d.mpms.legs){
      const warming = leg.direction === 'warming';
      const lp = warming ? (leg.inField ? 'LP-MW-I' : 'LP-MW-Z')     // measured while warming
                         : (leg.inField ? 'LP-MC-I' : 'LP-MC-Z');    // measured while cooling
      lps.add(lp);
      const exp = spec + '-' + lp;
      for(let i = 0; i < leg.T.length; i++){
        push({ experiment: exp, method_codes: lp,
               meas_temp: magicFmt(leg.T[i]),
               meas_field_dc: magicFmt(leg.H[i] * 1e-4),          // Oe → T
               magn_moment: magicFmt(leg.M[i] * 1e-3),            // emu → Am²
               description: leg.direction + (leg.inField ? ', in-field' : ', zero-field') });
      }
    }
  } else if(d.demag && d.demag.steps && d.demag.steps.length){
    // TDT / generic thermal series: zero-field steps LT-T-Z, in-field LT-T-I.
    // Thellier-style files export under LP-PI (checks noted in description);
    // plain thermal demag under LP-DIR-T.  CIT files carry mixed NRM/AF/LT/TT
    // steps and follow the PmagPy cit convention (LT-NO / LT-AF-Z / LT-LT-Z /
    // LT-T-Z; moment = intensity x volume, emu -> Am2).
    const isPI = d.demag.source === 'tdt', isCIT = d.demag.source === 'cit';
    const lp = isPI ? 'LP-PI' : 'LP-DIR-T';
    lps.add(lp);
    const exp = spec + '-' + lp;
    const vol = isCIT && d.demag.hdr && isFinite(d.demag.hdr.vol) && d.demag.hdr.vol > 0 ? d.demag.hdr.vol : 1;
    for(const st of d.demag.steps){
      if(isCIT){
        const emu = st.int * vol;                       // emu/cm3 x cm3
        const c = isFinite(st.sdec) ? pmagDir2cart(st.sdec, st.sinc, emu * 1e-3)
                                    : [st.mx * vol * 1e-3, st.my * vol * 1e-3, st.mz * vol * 1e-3];
        const mc = st.type === 'NRM' ? 'LT-NO' : st.type === 'AF' ? 'LT-AF-Z'
                 : st.type === 'LT' ? 'LT-LT-Z' : 'LT-T-Z';
        push({ experiment: exp, method_codes: mc + ':' + lp,
               treat_temp: st.type === 'TT' ? magicFmt(st.treat + 273.15)
                         : st.type === 'LT' ? magicFmt(st.treat || 77) : '273',
               treat_ac_field: st.type === 'AF' ? magicFmt(st.treat * 1e-3) : '0',
               dir_dec: magicFmt(st.sdec), dir_inc: magicFmt(st.sinc),
               magn_x: magicFmt(c[0]), magn_y: magicFmt(c[1]), magn_z: magicFmt(c[2]),
               magn_moment: magicFmt(emu * 1e-3), description: st.label });
        continue;
      }
      const m = Math.sqrt(st.mx*st.mx + st.my*st.my + st.mz*st.mz);
      const desc = st.code === 2 ? 'pTRM check' : st.code === 3 ? 'pTRM tail check'
                 : st.code === 4 ? 'additivity check' : '';
      push({ experiment: exp,
             method_codes: (st.inField ? 'LT-T-I' : 'LT-T-Z') + ':' + lp,
             treat_temp: magicFmt(st.treat + 273.15),
             treat_dc_field: (st.inField && isFinite(d.demag.labFieldUT)) ? magicFmt(d.demag.labFieldUT * 1e-6) : '',
             magn_x: magicFmt(st.mx), magn_y: magicFmt(st.my), magn_z: magicFmt(st.mz),
             magn_moment: magicFmt(m), description: desc });
    }
  } else if(d.vsm && d.vsm.kind === 'micromag-forc' && d.vsm.forcCurves){
    lps.add('LP-FORC');
    const exp = spec + '-LP-FORC';
    d.vsm.forcCurves.forEach((c, ci) => {
      for(let k = 0; k < c.Ha.length; k++){
        push({ experiment: exp, method_codes: 'LP-FORC',
               treat_dc_field: magicFmt(c.Hr),                    // reversal field (T)
               meas_field_dc: magicFmt(c.Ha[k]),                  // applied field at measurement (T)
               magn_moment: magicFmt(c.M[k]),
               description: 'FORC curve ' + (ci+1) + ', Hr=' + (c.Hr*1000).toFixed(2) + ' mT' });
      }
    });
  } else if(d.vsm && d.vsm.kind === 'hysteresis' && d.vsm.hyst){
    lps.add('LP-HYS');
    const exp = spec + '-LP-HYS', h = d.vsm.hyst;
    for(let i = 0; i < h.field.length; i++){
      push({ experiment: exp, method_codes: 'LP-HYS',
             meas_field_dc: magicFmt(h.field[i]), magn_moment: magicFmt(h.moment[i]) });
    }
  } else if(d.vsm && d.vsm.kind === 'dcd' && d.vsm.remanence){
    lps.add('LP-IRM-DCD');
    const exp = spec + '-LP-IRM-DCD', r = d.vsm.remanence;
    for(let i = 0; i < r.field.length; i++){
      push({ experiment: exp, method_codes: 'LT-IRM:LP-IRM-DCD',
             treat_dc_field: magicFmt(r.field[i]), magn_moment: magicFmt(r.moment[i]) });
    }
  } else if(d.steptypes && d.mvector){
    // 2G rmg step file. Classify each step; AF steps take their LP from the
    // most recent acquisition (NRM / IRM / ARM / RRM).
    let lastAcq = 'NRM';
    for(let i = 0; i < d.steptypes.length; i++){
      const st = (d.steptypes[i] || '').toLowerCase();
      const mx = d.mvector[0][i], my = d.mvector[1][i], mz = d.mvector[2][i];
      if(![mx,my,mz].every(v => typeof v === 'number' && isFinite(v))) continue;
      const fieldT = (d.levels && isFinite(d.levels[i])) ? d.levels[i] * 1e-4 : NaN;  // G → T
      const base = { magn_x: magicFmt(mx), magn_y: magicFmt(my), magn_z: magicFmt(mz),
                     magn_moment: magicFmt(Math.sqrt(mx*mx + my*my + mz*mz)) };
      let lt = null, lp = null, extra = {};
      if(st.startsWith('nrm')){ lastAcq = 'NRM'; lt = 'LT-NO'; lp = 'LP-DIR-AF'; }
      else if(st.startsWith('forc')){
        lt = 'LT-IRM'; lp = 'LP-FORC'; extra.treat_dc_field = magicFmt(fieldT);
        extra.description = 'remanence FORC node';
      }
      else if(st.startsWith('tt')){
        lt = 'LT-T-Z'; lp = 'LP-DIR-T';
        // rmg thermal level assumed °C → Kelvin (verify against a real thermal run)
        if(isFinite(d.levels && d.levels[i])) extra.treat_temp = magicFmt(d.levels[i] + 273.15);
      }
      else if(st.startsWith('trm')){
        lt = 'LT-T-I'; lp = 'LP-TRM';
        if(isFinite(d.levels && d.levels[i])) extra.treat_temp = magicFmt(d.levels[i] + 273.15);
      }
      else if(st.startsWith('irm')){ lastAcq = 'IRM'; lt = 'LT-IRM'; lp = 'LP-IRM';
        extra.treat_dc_field = magicFmt(fieldT); }
      else if(st.startsWith('arm')){ lastAcq = 'ARM'; lt = 'LT-AF-I'; lp = 'LP-ARM';
        extra.treat_ac_field = magicFmt(fieldT);
        if(d.treatmentDCFields && isFinite(d.treatmentDCFields[i]) && d.treatmentDCFields[i] !== 0)
          extra.treat_dc_field = magicFmt(d.treatmentDCFields[i]); }
      else if(st.startsWith('rrm')){ lastAcq = 'RRM'; lt = 'LT-AF-Z'; lp = null;   // MagIC has no RRM code
        extra.treat_ac_field = magicFmt(fieldT);
        extra.description = 'RRM acquisition' + (d.spin && isFinite(d.spin[i]) ?
          ', rotation ' + d.spin[i] + ' rps' : '') + ' (MagIC has no RRM method code)';
        extra.experiment = spec + '-RRM'; }
      else if(st.startsWith('af')){
        lt = 'LT-AF-Z';
        lp = ({ NRM:'LP-DIR-AF', IRM:'LP-IRM-AFD', ARM:'LP-ARM-AFD', RRM:'LP-DIR-AF' })[lastAcq];
        extra.treat_ac_field = magicFmt(fieldT);
      }
      else continue;   // susceptibility-only / unknown step types are skipped
      if(lp) lps.add(lp);
      push(Object.assign({ experiment: spec + '-' + (lp || 'RRM'),
                           method_codes: lt + (lp ? ':' + lp : '') }, base, extra));
    }
  }
  return { spec, rows, lps: [...lps], seqEnd: seq,
           description: (d.vsm && d.vsm.description) || (d.mpms && d.mpms.comment) || '' };
}

function magicExport(datas){
  const MEAS_COLS = ['measurement','experiment','specimen','sequence','standard','quality',
    'method_codes','citations','treat_ac_field','treat_dc_field','treat_temp',
    'meas_field_dc','meas_temp','magn_moment','magn_x','magn_y','magn_z','description'];
  const SPEC_COLS = ['specimen','sample','citations','method_codes','description'];
  const specRows = [], measRows = [];
  let seq = 1, exported = 0, skipped = [];
  for(const d of datas){
    const r = magicRowsForSample(d, seq);
    if(!r.rows.length){ skipped.push(d.samplename || '?'); continue; }
    seq = r.seqEnd; exported++;
    // measurement name = experiment + running number within the experiment
    const perExp = {};
    for(const row of r.rows){
      perExp[row.experiment] = (perExp[row.experiment] || 0) + 1;
      row.measurement = row.experiment + '-' + perExp[row.experiment];
    }
    specRows.push({ specimen: r.spec, sample: r.spec, citations: 'This study',
                    method_codes: r.lps.filter(Boolean).join(':'), description: r.description });
    measRows.push(...r.rows);
  }
  if(!measRows.length) return { error: 'no exportable data in the selected samples' };
  const tab = (name, cols, rows) =>
    'tab delimited\t' + name + '\n' + cols.join('\t') + '\n' +
    rows.map(r => cols.map(c => (r[c] === undefined || r[c] === null) ? '' : String(r[c])).join('\t')).join('\n');
  const text = tab('specimens', SPEC_COLS, specRows) + '\n>>>>>>>>>>\n' +
               tab('measurements', MEAS_COLS, measRows) + '\n';
  return { text, nSpec: specRows.length, nMeas: measRows.length, skipped };
}

function exportMagicSelected(){
  const sel = S.samples.filter(s => s.selected).map(s => s._d);
  if(!sel.length){ log('✗ MagIC export: no samples selected', 'err'); return; }
  const res = magicExport(sel);
  if(res.error){ log('✗ MagIC export: ' + res.error, 'err'); return; }
  const blob = new Blob([res.text], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'pyrockmag_magic.txt';
  a.click();
  URL.revokeObjectURL(a.href);
  if(res.skipped.length) log('⚠ MagIC export: skipped (no exportable data): ' + res.skipped.join(', '), 'warn');
  log('⇣ MagIC export: ' + res.nSpec + ' specimen(s), ' + res.nMeas + ' measurement rows → pyrockmag_magic.txt' +
      ' — add locations/sites/samples tables in the MagIC online editor', 'ok');
}

function frcConvDownload(){
  try {
    const { sample, multiplier } = frcConvGetOpts();
    const frcText = convertRmgToFrc(sample.data, { multiplier });
    const fn = document.getElementById('frc-fn').value.trim() || 'sample.frc';
    const blob = new Blob([frcText], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = fn;
    a.click();
    URL.revokeObjectURL(a.href);
    document.getElementById('forc-result').style.color = 'var(--ac2)';
    document.getElementById('forc-result').textContent = '✓ downloaded ' + fn;
  } catch(e){
    document.getElementById('forc-result').style.color = 'var(--red)';
    document.getElementById('forc-result').textContent = '✗ ' + e.message;
  }
}

function showForcModal(){
  document.getElementById('forc-ov').classList.add('vis');
  document.getElementById('forc-result').textContent = '';
  document.getElementById('forc-info').style.display = 'none';
  forcSwitchTab('gen');
}
function hideForcModal(){ document.getElementById('forc-ov').classList.remove('vis'); }

function forcReadForm(){
  const startMT = parseFloat(document.getElementById('forc-start').value);
  const stopMT  = parseFloat(document.getElementById('forc-stop').value);
  const stepMT  = parseFloat(document.getElementById('forc-step').value);
  if(!(startMT > 0 && stopMT > startMT && stepMT > 0)) throw new Error('Invalid field values');
  return {
    startMT, stopMT, stepMT,
    saturation: document.getElementById('forc-sat').checked,
    exponential: document.getElementById('forc-exp').checked,
    expBase: 1.3,
  };
}

function forcPreviewCount(){
  try {
    const opts = forcReadForm();
    const text = generateForcScript(opts);
    const lines = text.split('\r\n');
    // Count reversal curves (FORCz with negative field)
    let nReversals = 0;
    let nMeas = 0;
    for(let i=0;i<lines.length;i++){
      const l = lines[i];
      if(!l.startsWith('FORCz')) continue;
      const field = parseInt(l.split(',')[1]);
      if(field < 0) nReversals++;
      else if(field > 0) nMeas++;
    }
    const info = document.getElementById('forc-info');
    info.style.display = 'block';
    info.innerHTML =
      '<div style="color:var(--ac2);margin-bottom:4px">preview:</div>' +
      '• <b>' + (lines.length - 1) + '</b> total lines<br>' +
      '• <b>' + nReversals + '</b> reversal curves<br>' +
      '• <b>' + nMeas + '</b> measurement pulses<br>' +
      '• spacing: <b>' + (opts.exponential ? 'exponential (base 1.3)' : 'linear ' + opts.stepMT + ' mT') + '</b><br>' +
      '• mode: <b>' + (opts.saturation ? 'saturation FORC' : 'standard FORC') + '</b>';
    document.getElementById('forc-result').textContent = '';
  } catch(e){
    document.getElementById('forc-result').style.color = 'var(--red)';
    document.getElementById('forc-result').textContent = '✗ ' + e.message;
  }
}

function forcDownload(){
  try {
    const opts = forcReadForm();
    const text = generateForcScript(opts);
    const fn = document.getElementById('forc-fn').value.trim() || 'forc_protocol.rmg';
    const blob = new Blob([text], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = fn;
    a.click();
    URL.revokeObjectURL(a.href);
    document.getElementById('forc-result').style.color = 'var(--ac2)';
    document.getElementById('forc-result').textContent = '✓ downloaded ' + fn;
  } catch(e){
    document.getElementById('forc-result').style.color = 'var(--red)';
    document.getElementById('forc-result').textContent = '✗ ' + e.message;
  }
}

// Esc also closes SAM and FORC modals
(function(){
  const prevHandler = window.onkeydown;  // shouldn't exist but just in case
  document.addEventListener('keydown', e => {
    if(e.key === 'Escape'){
      hideSamModal();
      hideForcModal();
    }
  });
})();



// Apply user-typed axis limit inputs to the current FORC diagram.
// Empty inputs = auto (null). A partial set (e.g. only Bc min) also counts
// as auto until the pair is complete.
function forcApplyAxisLimits(){
  const bcMin = parseFloat(document.getElementById('forc-bc-min').value);
  const bcMax = parseFloat(document.getElementById('forc-bc-max').value);
  const buMin = parseFloat(document.getElementById('forc-bu-min').value);
  const buMax = parseFloat(document.getElementById('forc-bu-max').value);
  ForcDiagState.bcMin = (Number.isFinite(bcMin) && Number.isFinite(bcMax) && bcMin < bcMax) ? bcMin : null;
  ForcDiagState.bcMax = (Number.isFinite(bcMin) && Number.isFinite(bcMax) && bcMin < bcMax) ? bcMax : null;
  ForcDiagState.buMin = (Number.isFinite(buMin) && Number.isFinite(buMax) && buMin < buMax) ? buMin : null;
  ForcDiagState.buMax = (Number.isFinite(buMin) && Number.isFinite(buMax) && buMin < buMax) ? buMax : null;
  // Re-render if FORC_DIAG is active
  if(S.activeOp === 'FORC_DIAG' && S.samples.length > 0){
    const sel = S.samples.filter(s => s.selected);
    if(sel.length > 0) runPlot(sel.map(s => s._d), 'FORC_DIAG');
  }
}

// Auto-zoom: find bounding box of cells where |ρ| > 5% × max(|ρ|), pad 10%,
// clamp to data range. Fallback: if the significant region is degenerate or
// <10 mT wide, show full data range.
function forcAutoZoom(){
  const r = ForcDiagState.lastResult;
  if(!r){ return; }
  const gs = r.gridSize;
  // Convert grid to mT via Hc/Hu * 1000 as in tForcDiag
  // We need the xs, ys that the trace uses. Recompute from the result.
  // Compute absolute max rho in the valid region.
  let rhoMax = 0;
  for(let i=0;i<gs;i++) for(let j=0;j<gs;j++){
    if(!r.validMask[i][j]) continue;
    const v = r.rho[i][j];
    if(Number.isFinite(v) && Math.abs(v) > rhoMax) rhoMax = Math.abs(v);
  }
  if(rhoMax === 0){ forcResetZoom(); return; }
  const threshold = rhoMax * 0.05;

  // Find bounding box of significant cells in (Hc, Hu) — units are Tesla in the grid
  let hcMinT = Infinity, hcMaxT = -Infinity, huMinT = Infinity, huMaxT = -Infinity;
  for(let i=0;i<gs;i++) for(let j=0;j<gs;j++){
    if(!r.validMask[i][j]) continue;
    const v = r.rho[i][j];
    if(!Number.isFinite(v) || Math.abs(v) < threshold) continue;
    const hc = r.Hc[i][j], hu = r.Hu[i][j];
    if(hc < hcMinT) hcMinT = hc;
    if(hc > hcMaxT) hcMaxT = hc;
    if(hu < huMinT) huMinT = hu;
    if(hu > huMaxT) huMaxT = hu;
  }
  if(!Number.isFinite(hcMinT) || !Number.isFinite(hcMaxT)){ forcResetZoom(); return; }

  // Convert to mT and pad by 10% (minimum 5 mT padding)
  let bcMinMT = hcMinT * 1000;
  let bcMaxMT = hcMaxT * 1000;
  let buMinMT = huMinT * 1000;
  let buMaxMT = huMaxT * 1000;
  const bcRange = bcMaxMT - bcMinMT;
  const buRange = buMaxMT - buMinMT;

  // Degenerate check: if the region is tiny (<10 mT), give up and show full
  if(bcRange < 10 && buRange < 10){ forcResetZoom(); return; }

  const bcPad = Math.max(5, bcRange * 0.1);
  const buPad = Math.max(5, buRange * 0.1);
  bcMinMT = Math.max(0, bcMinMT - bcPad);                  // clamp Bc to ≥0
  bcMaxMT = bcMaxMT + bcPad;
  // Symmetric Bu around 0 looks better for FORC than asymmetric clipping
  const buAbs = Math.max(Math.abs(buMinMT), Math.abs(buMaxMT)) + buPad;
  buMinMT = -buAbs;
  buMaxMT = buAbs;

  // Round to multiples of 5 mT for clean tick labels
  const round5 = v => Math.round(v / 5) * 5;
  bcMinMT = round5(bcMinMT);
  bcMaxMT = round5(bcMaxMT);
  buMinMT = round5(buMinMT);
  buMaxMT = round5(buMaxMT);

  ForcDiagState.bcMin = bcMinMT;
  ForcDiagState.bcMax = bcMaxMT;
  ForcDiagState.buMin = buMinMT;
  ForcDiagState.buMax = buMaxMT;

  // Reflect back into the input boxes so user sees the values
  document.getElementById('forc-bc-min').value = bcMinMT;
  document.getElementById('forc-bc-max').value = bcMaxMT;
  document.getElementById('forc-bu-min').value = buMinMT;
  document.getElementById('forc-bu-max').value = buMaxMT;

  // Re-render
  if(S.activeOp === 'FORC_DIAG' && S.samples.length > 0){
    const sel = S.samples.filter(s => s.selected);
    if(sel.length > 0) runPlot(sel.map(s => s._d), 'FORC_DIAG');
  }
}

// Reset: clear overrides so axes show the full measurement range (default behavior).
function forcResetZoom(){
  ForcDiagState.bcMin = null;
  ForcDiagState.bcMax = null;
  ForcDiagState.buMin = null;
  ForcDiagState.buMax = null;
  const els = ['forc-bc-min','forc-bc-max','forc-bu-min','forc-bu-max'];
  for(const id of els){
    const e = document.getElementById(id);
    if(e) e.value = '';
  }
  if(S.activeOp === 'FORC_DIAG' && S.samples.length > 0){
    const sel = S.samples.filter(s => s.selected);
    if(sel.length > 0) runPlot(sel.map(s => s._d), 'FORC_DIAG');
  }
}

function forcDiagRecompute(){
  const sfEl = document.getElementById('forc-sf');
  const gsEl = document.getElementById('forc-gs');
  const cmEl = document.getElementById('forc-cm');
  if(!sfEl || !gsEl) return;
  const sf = parseInt(sfEl.value);
  const gs = gsEl.value === 'auto' ? 'auto' : parseInt(gsEl.value);
  if(Number.isFinite(sf) && sf >= 0 && sf <= 10) ForcDiagState.smoothingFactor = sf;
  if(gs === 'auto' || (Number.isFinite(gs) && gs > 0 && gs <= 500)) ForcDiagState.gridSize = gs;
  if(cmEl && FORC_COLORMAPS[cmEl.value]) ForcDiagState.colormap = cmEl.value;
  // Re-run the FORC_DIAG plot if that's the current op
  if(S.activeOp === 'FORC_DIAG' && S.samples && S.samples.length > 0){
    const selSamps = S.samples.filter(s => s.active);
    if(selSamps.length > 0){
      const t0 = performance.now();
      runPlot(selSamps, 'FORC_DIAG');
      const dt = performance.now() - t0;
      const info = document.getElementById('forc-diag-info');
      if(info){
        const r = ForcDiagState.lastResult;
        if(r){
          info.textContent = `${r.forcData.curves.length} curves · ${dt.toFixed(0)}ms`;
        } else {
          info.textContent = 'no FORC data';
        }
      }
    }
  }
}

// ── Dashboard splitters (draggable within the 3×2 grid) ──────────────────────
(function(){
  function initDashSplitter(el, axis, varName, minBefore, minAfter){
    if(!el) return;
    el.addEventListener('mousedown', e => {
      e.preventDefault();
      const grid = document.getElementById('dash-grid');
      const rect = grid.getBoundingClientRect();
      const isH = axis === 'h';
      const start = isH ? e.clientY : e.clientX;
      const total = isH ? rect.height : rect.width;
      const cs = getComputedStyle(document.documentElement);
      const v = parseFloat(cs.getPropertyValue(varName)) || total / (varName.startsWith('--dc') ? 3 : 2);
      el.classList.add('dragging');
      function onMove(ev){
        const delta = (isH ? ev.clientY : ev.clientX) - start;
        const newSize = Math.max(minBefore, Math.min(total - minAfter, v + delta));
        document.documentElement.style.setProperty(varName, newSize + 'px');
        requestAnimationFrame(() => {
          for(let i=0;i<5;i++){
            const c = document.getElementById('d'+i);
            if(c) Plotly.Plots.resize(c);
          }
        });
      }
      function onUp(){
        el.classList.remove('dragging');
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  }
  // Hook up after DOM ready
  setTimeout(() => {
    initDashSplitter(document.getElementById('dvsp1'), 'v', '--dc1', 120, 240);
    initDashSplitter(document.getElementById('dvsp2'), 'v', '--dc2', 120, 120);
    initDashSplitter(document.getElementById('dhsp1'), 'h', '--dr1', 120, 120);
  }, 50);
})();

renderOps();
renderSamples();
{ const bt=document.getElementById('build-tag'); if(bt) bt.textContent='build '+PYRM_BUILD; }
setStatus('ok','ready — drop .rmg files to begin');
log('pure JavaScript — instant startup, no Python runtime needed', 'ok');
maybeShowRestore();
</script>
</body>
</html>
